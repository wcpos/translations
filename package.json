{
  "name": "@wcpos/translations",
  "version": "0.1.0",
  "private": true,
  "description": "Translation management for WCPOS apps and plugins",
  "scripts": {
    "extract:js": "node scripts/extract-js-strings.js",
    "extract:php": "node scripts/extract-php-strings.js",
    "translate": "node scripts/translate-locale.js",
    "translate:pr": "node scripts/translate-with-pr.js",
    "qa": "node scripts/qa-translations.js",
    "generate:php": "node scripts/generate-php-files.js",
    "validate": "node scripts/validate-translations.js",
    "check:completeness": "node scripts/check-completeness.js",
    "test": "node tests/test-extraction.js && node tests/test-translation.js --dry-run && node tests/test-i18next-format.js",
    "test:extraction": "node tests/test-extraction.js",
    "test:translation": "node tests/test-translation.js",
    "test:i18next": "node tests/test-i18next-format.js",
    "test:workflow": "node tests/test-workflow.js",
    "test:all": "node tests/test-extraction.js && node tests/test-translation.js && node tests/test-workflow.js && node tests/test-i18next-format.js",
    "test:score": "node tests/score-translation.js",
    "generate:fallbacks": "node scripts/generate-fallbacks.js",
    "cleanup:stale": "node scripts/cleanup-stale-keys.js",
    "test:openclaw": "node tests/test-wait-for-openclaw-task.js"
  },
  "dependencies": {
    "gettext-parser": "^9.0.2",
    "glob": "^11.0.0",
    "openai": "^6.33.0",
    "wp-pot": "^1.10.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1"
}
