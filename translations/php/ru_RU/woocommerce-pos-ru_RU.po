#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – точка продаж для WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Простой интерфейс для приема заказов WooCommerce в точке продаж. Требуется "
"<a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> требует PHP %1$s или выше. Узнайте больше о <a "
"href=\"%2$s\">том, как обновить</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> требует <a href=\"%1$s\">WooCommerce %2$s или "
"выше</a>. Пожалуйста, <a href=\"%3$s\">установите и активируйте "
"WooCommerce</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> требует <em>красивых</em> постоянных "
"ссылок для корректной работы"

msgid "Enable permalinks"
msgstr "Включить постоянные ссылки"

msgid "Cashier"
msgstr "Кассир"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> требует <a href=\"%1$s\">WCPOS Pro %2$s или "
"выше</a>. Пожалуйста, <a href=\"%3$s\">установите и активируйте WCPOS "
"Pro</a>"

