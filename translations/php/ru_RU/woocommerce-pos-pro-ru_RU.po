msgstr "Готово к отправке на терминал: %s."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:74
msgid "Sending to the terminal…"
msgstr "Отправка на терминал…"

#: includes/Payments/OrderPay/Order_Pay_Panel.php:75
msgid "Waiting for the customer at the terminal…"
msgstr "Ожидание покупателя у терминала…"

#: includes/Payments/OrderPay/Order_Pay_Panel.php:76
msgid "Approved — finishing…"
msgstr "Одобрено — завершаем…"

#: includes/Payments/OrderPay/Order_Pay_Panel.php:77
msgid "Paid. Finishing the order…"
msgstr "Оплачено. Завершаем заказ…"

#: includes/Payments/OrderPay/Order_Pay_Panel.php:78
msgid "Cancelling — waiting for the terminal to confirm…"
msgstr "Отмена — ожидаем подтверждения от терминала…"

#: includes/Payments/OrderPay/Order_Pay_Panel.php:79
msgid "Cancelled on the terminal. Nothing was charged."
msgstr "Отменено на терминале. Списание не выполнено."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:80
msgid "The terminal declined or cancelled the payment."
msgstr "Терминал отклонил или отменил платёж."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:81
msgid "Card declined."
msgstr "Карта отклонена."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:82
msgid "No card was presented in time."
msgstr "Карту не предъявили вовремя."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:83
msgid ""
"The amount confirmed by the terminal did not match. Check the terminal and the order."
msgstr ""
"Сумма, подтверждённая терминалом, не совпадает. Проверьте терминал и заказ."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:85
msgid ""
"A payment with another method is already in progress on this order. Finish or cancel it first."
msgstr ""
"Для этого заказа уже выполняется оплата другим способом. Сначала завершите или отмените её."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:86
