#. translators: wordpress
msgid "Loading&#8230;"
msgstr "Загрузка&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "Выберите пользователей, которые имеют доступ к этому магазину."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"Примечание: только пользователи с соответствующими привилегиями будут "
"доступны для выбора. <a href=\"%s\" target=\"_blank\">См. документацию для "
"подробностей.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Веб-адрес"

#. translators: wordpress
msgid "Email"
msgstr "Электронная почта"

msgid "Opening Hours notes"
msgstr "Примечания к часам работы"

msgid "eg: Closed public holidays"
msgstr "например: Закрыто в праздничные дни"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Вы можете добавить часы работы на ваш сайт с помощью виджета. <a "
"href=\"%s\">Прочтите документацию</a> для получения дополнительной "
"информации."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"Пожалуйста, <a href=\"%s\">прочтите документацию</a> для получения "
"информации о том, как настроить ваши чеки POS."

msgid "Enable store price field"
msgstr "Включить поле цены магазина"

msgid "Complimentary Close"
msgstr "Благодарственное закрытие"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr ""
"Личные заметки или сезонные поздравления, например, Спасибо за ваш заказ! "
"или С Рождеством!"

msgid "Returns Policy"
msgstr "Политика возврата"

msgid "Returns policy, terms and conditions"
msgstr "Политика возврата, условия и положения"

msgid "Footer"
msgstr "Нижний колонтитул"

msgid "Further footer information, e.g. copyright or branding"
msgstr ""
"Дополнительная информация в нижнем колонтитуле, например, авторские права "
"или брендинг"

msgid "Calculate Tax Based On"
msgstr "Рассчитать налог на основе"

msgid "this store address"
msgstr "адреса этого магазина"

msgid "base location"
msgstr "базового местоположения"

msgid "No tax rates set"
msgstr "Ставки налога не установлены"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Указанные выше налоговые ставки будут использоваться в точке продажи. Вы "
"можете <a href=\"%s\">изменить налоговую ставку</a> в настройках "
"WooCommerce."

msgid "POS Barcode"
msgstr "Штрихкод POS"

msgid "Product barcode used at the point of sale"
msgstr "Штрихкод продукта, используемый на точке продаж"

msgid "Something went wrong. Please try again later."
msgstr "Что-то пошло не так. Пожалуйста, попробуйте позже."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Установка плагина"

msgid "Your WCPOS Pro license is valid and active."
msgstr "Ваша лицензия WCPOS Pro действительна и активна."

msgid "You are receiving plugin updates."
msgstr "Вы получаете обновления плагина."

msgid "Your WCPOS Pro license is inactive."
msgstr "Ваша лицензия WCPOS Pro неактивна."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">Нажмите здесь</a>, чтобы активировать ваш лицензионный ключ."

msgid "Your WCPOS Pro license has expired."
msgstr "Срок действия вашей лицензии WCPOS Pro истек."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Пожалуйста, продлите</a>, чтобы получать обновления."

msgid "Your WCPOS Pro license is inactive"
msgstr "Ваша лицензия WCPOS Pro неактивна"

msgid "Your WCPOS Pro license has expired"
msgstr "Срок действия вашей лицензии WCPOS Pro истек"

msgid "Failed to save settings."
msgstr "Не удалось сохранить настройки."

msgid "Add New Store"
msgstr "Добавить новый магазин"

msgid "New Store"
msgstr "Новый магазин"

msgid "Edit Store"
msgstr "Редактировать магазин"

msgid "View Store"
msgstr "Просмотр магазина"

msgid "Search Stores"
msgstr "Поиск магазинов"

msgid "Parent Store:"
msgstr "Родительский магазин:"

msgid "No Stores found."
msgstr "Магазины не найдены."

msgid "No Stores found in Trash."
msgstr "В корзине магазины не найдены."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "Не удалось загрузить WCPOS Pro. Пожалуйста, выполните composer install."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin "
"has been automatically deactivated. You may safely delete it from your "
"plugins."
msgstr ""
"теперь включает все функции из бесплатного плагина. Автономный бесплатный "
"плагин был автоматически деактивирован. Вы можете безопасно удалить его из "
"ваших плагинов."

msgctxt "All authorized users"
msgid "All"
msgstr "Все"