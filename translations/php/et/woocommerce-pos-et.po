#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> vajab <a href=\"%1$s\">WooCommerce %2$s või "
"uuemat</a>. Palun <a href=\"%3$s\">paigalda ja aktiveeri WooCommerce</a>"

