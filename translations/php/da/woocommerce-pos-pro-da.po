msgstr "Indlæser&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "Vælg de brugere, der er autoriseret til at få adgang til denne butik."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"Bemærk: kun de brugere med de rette rettigheder vil være tilgængelige for valg. <a href=\"%s\" target=\"_blank\">Se dokumentationen for detaljer.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Webadresse"

#. translators: wordpress
msgid "Email"
msgstr "E-mail"

msgid "Opening Hours notes"
msgstr "Åbningstider noter"

msgid "eg: Closed public holidays"
msgstr "f.eks.: Lukket på helligdage"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Du kan tilføje åbningstider til din hjemmeside ved hjælp af en widget. <a href=\"%s\">Læs dokumentationen</a> for mere information."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"Venligst <a href=\"%s\">læs dokumentationen</a> for information om, hvordan du tilpasser dine POS-kvitteringer."

msgid "Enable store price field"
msgstr "Aktiver butiksprisfelt"

msgid "Complimentary Close"
msgstr "Komplimentær afslutning"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"Personlige noter eller sæsonhilsner, f.eks. Tak for din bestilling! eller Glædelig jul!"

msgid "Returns Policy"
msgstr "Returpolitik"

msgid "Returns policy, terms and conditions"
msgstr "Returpolitik, vilkår og betingelser"

msgid "Footer"
msgstr "Sidefod"

msgid "Further footer information, e.g. copyright or branding"
msgstr "Yderligere sidefodsinformation, f.eks. copyright eller branding"

msgid "Calculate Tax Based On"
msgstr "Beregn skat baseret på"

msgid "this store address"
msgstr "denne butiksadresse"

msgid "base location"
msgstr "baselokation"

msgid "No tax rates set"
msgstr "Ingen skattesatser indstillet"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"De ovenstående skattesatser vil blive brugt ved salgsstedet. Du kan <a href=\"%s\">ændre skattesatsen</a> i WooCommerce-indstillingerne."

msgid "POS Barcode"
msgstr "POS-stregkode"

msgid "Product barcode used at the point of sale"
msgstr "Produktstregkode brugt ved salgsstedet"

msgid "Something went wrong. Please try again later."
msgstr "Noget gik galt. Prøv venligst igen senere."

