#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – נקודת מכירה ל-WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all "
"features from the free plugin plus multi-store support, custom receipts, "
"and more."
msgstr ""
"פתרון נקודת מכירה מלא ל-WooCommerce. גרסת ה-Pro כוללת את כל התכונות מהתוסף "
"החינמי בנוסף לתמיכה בריבוי חנויות, קבלות מותאמות אישית ועוד."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "חנויות"

msgid "Cashiers"
msgstr "קופאים"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS Pro הוא כעת עצמאי."

msgid ""
"The Pro plugin includes all features from the free version. You can safely "
"deactivate and delete this plugin."
msgstr ""
"התוסף Pro כולל את כל התכונות מהגרסה החינמית. ניתן לבטל ולהסיר את התוסף הזה "
"בבטחה."

msgid "Open POS"
msgstr "פתח POS"

msgid "Store"
msgstr "חנות"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "משתמשים מורשים"

msgid "Opening Hours"
msgstr "שעות פתיחה"

msgid "Logo"
msgstr "לוגו"

#. translators: wordpress.
msgid "Contact Info"
msgstr "פרטי קשר"

msgid "Receipt Options"
msgstr "אפשרויות קבלה"

msgid "Set featured image"
msgstr "הגדר תמונה מוצגת"

msgid "Set store logo"
msgstr "הגדר לוגו חנות"

msgid "Remove featured image"
msgstr "הסר תמונה מוצגת"

msgid "Remove store logo"
msgstr "הסר לוגו חנות"

msgid "Set Store Logo"
msgstr "הגדר לוגו חנות"

