#. translators: wordpress
msgid "Loading&#8230;"
msgstr "טוען&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "בחר את המשתמשים המורשים לגשת לחנות זו."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"הערה: רק משתמשים עם ההרשאות המתאימות יהיו זמינים לבחירה. <a href=\"%s\" "
"target=\"_blank\">ראה את התיעוד לפרטים נוספים.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "כתובת אינטרנט"

#. translators: wordpress
msgid "Email"
msgstr "דואר אלקטרוני"

msgid "Opening Hours notes"
msgstr "הערות לשעות פתיחה"

msgid "eg: Closed public holidays"
msgstr "לדוגמה: סגור בחגים ציבוריים"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"ניתן להוסיף שעות פתיחה לאתר שלך באמצעות ווידג'ט. <a href=\"%s\">קרא את "
"התיעוד</a> למידע נוסף."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"אנא <a href=\"%s\">קרא את התיעוד</a> למידע על איך להתאים אישית את הקבלות "
"שלך ב-POS."

msgid "Enable store price field"
msgstr "הפעל שדה מחיר חנות"

msgid "Complimentary Close"
msgstr "סגירה משלימה"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr "הערות אישיות או ברכות עונתיות, לדוגמה: תודה על ההזמנה שלך! או חג מולד שמח!"

msgid "Returns Policy"
msgstr "מדיניות החזרות"

msgid "Returns policy, terms and conditions"
msgstr "מדיניות החזרות, תנאים והגבלות"

msgid "Footer"
msgstr "כותרת תחתונה"

msgid "Further footer information, e.g. copyright or branding"
msgstr "מידע נוסף לכותרת תחתונה, לדוגמה: זכויות יוצרים או מיתוג"

msgid "Calculate Tax Based On"
msgstr "חשב מס על בסיס"

msgid "this store address"
msgstr "כתובת חנות זו"

msgid "base location"
msgstr "מיקום בסיסי"

msgid "No tax rates set"
msgstr "לא הוגדרו שיעורי מס"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"שיעורי המס הנ\"ל ישמשו בנקודת המכירה. ניתן <a href=\"%s\">לשנות את שיעור "
"המס</a> בהגדרות WooCommerce."

msgid "POS Barcode"
msgstr "ברקוד POS"

msgid "Product barcode used at the point of sale"
msgstr "ברקוד מוצר המשמש בנקודת המכירה"

msgid "Something went wrong. Please try again later."
msgstr "משהו השתבש. אנא נסה שוב מאוחר יותר."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "התקנת תוסף"

msgid "Your WCPOS Pro license is valid and active."
msgstr "הרישיון שלך ל-WCPOS Pro תקף ופעיל."

msgid "You are receiving plugin updates."
msgstr "אתה מקבל עדכוני תוסף."

msgid "Your WCPOS Pro license is inactive."
msgstr "הרישיון שלך ל-WCPOS Pro אינו פעיל."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">לחץ כאן</a> כדי להפעיל את מפתח הרישיון שלך."

msgid "Your WCPOS Pro license has expired."
msgstr "הרישיון שלך ל-WCPOS Pro פג תוקף."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">אנא חידש</a> כדי לקבל עדכונים."

msgid "Your WCPOS Pro license is inactive"
msgstr "הרישיון שלך ל-WCPOS Pro אינו פעיל"

msgid "Your WCPOS Pro license has expired"
msgstr "הרישיון שלך ל-WCPOS Pro פג תוקף"

msgid "Failed to save settings."
msgstr "שמירת ההגדרות נכשלה."

msgid "Add New Store"
msgstr "הוסף חנות חדשה"

msgid "New Store"
msgstr "חנות חדשה"

msgid "Edit Store"
msgstr "ערוך חנות"

msgid "View Store"
msgstr "הצג חנות"

msgid "Search Stores"
msgstr "חפש חנויות"

msgid "Parent Store:"
msgstr "חנות אב:"

msgid "No Stores found."
msgstr "לא נמצאו חנויות."

msgid "No Stores found in Trash."
msgstr "לא נמצאו חנויות בפח."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "הטעינה של WCPOS Pro נכשלה. אנא הפעל את composer install."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin "
"has been automatically deactivated. You may safely delete it from your "
"plugins."
msgstr ""
"כעת כולל את כל התכונות מהתוסף החינמי. התוסף החינמי העצמאי הושבת אוטומטית. "
"ניתן למחוק אותו בבטחה מהתוספים שלך."

msgctxt "All authorized users"
msgid "All"
msgstr "הכל"