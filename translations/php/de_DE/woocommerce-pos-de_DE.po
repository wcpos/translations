#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Kassensystem für WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. Requires <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Ein einfaches Frontend zur Annahme von WooCommerce-Bestellungen am Verkaufspunkt. Erfordert <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> erfordert PHP %1$s oder höher. Lesen Sie mehr darüber, <a href=\"%2$s\">wie Sie aktualisieren können</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> erfordert <a href=\"%1$s\">WooCommerce %2$s oder höher</a>. Bitte <a href=\"%3$s\">installieren und aktivieren Sie WooCommerce</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> erfordert <em>schöne</em> Permalinks, um korrekt zu funktionieren"

msgid "Enable permalinks"
msgstr "Permalinks aktivieren"

