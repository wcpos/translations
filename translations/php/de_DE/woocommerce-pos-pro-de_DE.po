msgid "Web Address"
msgstr "Webadresse"

#. translators: wordpress
msgid "Email"
msgstr "E-Mail"

msgid "Opening Hours notes"
msgstr "Notizen zu den Öffnungszeiten"

msgid "eg: Closed public holidays"
msgstr "z.B.: An Feiertagen geschlossen"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Sie können die Öffnungszeiten mit einem Widget zu Ihrer Website hinzufügen. "
"<a href=\"%s\">Lesen Sie die Dokumentation</a> für weitere Informationen."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"Bitte <a href=\"%s\">lesen Sie die Dokumentation</a>, um Informationen zur "
"Anpassung Ihrer POS-Belege zu erhalten."

