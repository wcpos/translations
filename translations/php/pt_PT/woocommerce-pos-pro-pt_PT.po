#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Pode adicionar o horário de funcionamento ao seu site usando um widget. <a "
"href=\"%s\">Leia a documentação</a> para mais informações."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"Por favor, <a href=\"%s\">leia a documentação</a> para informações sobre "
"como personalizar os seus recibos POS."

msgid "Enable store price field"
msgstr "Ativar campo de preço da loja"

msgid "Complimentary Close"
msgstr "Fecho Complementar"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr ""
"Notas pessoais ou saudações sazonais, ex: Obrigado pela sua encomenda! ou "
"Feliz Natal!"

msgid "Returns Policy"
msgstr "Política de Devoluções"

msgid "Returns policy, terms and conditions"
msgstr "Política de devoluções, termos e condições"

