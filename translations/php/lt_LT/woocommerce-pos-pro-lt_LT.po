msgstr "Įskiepio diegimas"

msgid "Your WCPOS Pro license is valid and active."
msgstr "Jūsų WCPOS Pro licencija galioja ir yra aktyvi."

msgid "You are receiving plugin updates."
msgstr "Jūs gaunate įskiepio atnaujinimus."

msgid "Your WCPOS Pro license is inactive."
msgstr "Jūsų WCPOS Pro licencija yra neaktyvi."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr ""
"<a href=\"%s\">Spustelėkite čia</a>, kad aktyvuotumėte savo licencijos "
"raktą."

msgid "Your WCPOS Pro license has expired."
msgstr "Jūsų WCPOS Pro licencija yra pasibaigusi."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Atnaujinkite</a>, kad gautumėte atnaujinimus."

