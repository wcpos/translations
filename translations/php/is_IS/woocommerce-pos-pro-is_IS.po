#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"Athugið: aðeins notendur með réttar heimildir verða tiltækir til vals. <a href=\"%s\" target=\"_blank\">Sjáðu skjölin fyrir nánari upplýsingar.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Vefslóð"

#. translators: wordpress
msgid "Email"
msgstr "Netfang"

msgid "Opening Hours notes"
msgstr "Athugasemdir um opnunartíma"

msgid "eg: Closed public holidays"
msgstr "td: Lokað á almennum frídögum"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Þú getur bætt við opnunartímum á vefsíðuna þína með viðbót. <a href=\"%s\">Lestu skjölin</a> fyrir frekari upplýsingar."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"Vinsamlegast <a href=\"%s\">lesið skjölin</a> fyrir upplýsingar um hvernig á að sérsníða POS kvittanir."

msgid "Enable store price field"
msgstr "Virkja verðsvæði verslunar"

msgid "Complimentary Close"
msgstr "Viðbótar lokun"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"Persónulegar athugasemdir eða árstíðarkveðjur, td Takk fyrir pöntunina! eða Gleðileg jól!"

msgid "Returns Policy"
msgstr "Skilastefna"

msgid "Returns policy, terms and conditions"
msgstr "Skilastefna, skilmálar og skilyrði"

msgid "Footer"
msgstr "Fótur"

msgid "Further footer information, e.g. copyright or branding"
msgstr "Frekari upplýsingar í fót, td höfundarréttur eða vörumerki"

msgid "Calculate Tax Based On"
msgstr "Reikna skatt út frá"

msgid "this store address"
msgstr "þessari verslunarheimilisfangi"

msgid "base location"
msgstr "grunnstaðsetning"

msgid "No tax rates set"
msgstr "Engin skattprósenta sett"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Skattprósenturnar hér að ofan verða notaðar við sölustað. Þú getur <a href=\"%s\">breytt skattprósentu</a> í WooCommerce stillingum."

msgid "POS Barcode"
msgstr "POS strikamerki"

msgid "Product barcode used at the point of sale"
msgstr "Vöru strikamerki notað við sölustað"

msgid "Something went wrong. Please try again later."
msgstr "Eitthvað fór úrskeiðis. Reyndu aftur síðar."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Uppsetning viðbótar"

msgid "Your WCPOS Pro license is valid and active."
msgstr "WCPOS Pro leyfið þitt er gilt og virkt."

msgid "You are receiving plugin updates."
msgstr "Þú ert að fá uppfærslur fyrir viðbótina."

msgid "Your WCPOS Pro license is inactive."
msgstr "WCPOS Pro leyfið þitt er óvirkt."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">Smelltu hér</a> til að virkja leyfislykilinn þinn."

msgid "Your WCPOS Pro license has expired."
msgstr "WCPOS Pro leyfið þitt er útrunnið."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Vinsamlegast endurnýjaðu</a> til að fá uppfærslur."

msgid "Your WCPOS Pro license is inactive"
msgstr "WCPOS Pro leyfið þitt er óvirkt"

msgid "Your WCPOS Pro license has expired"
msgstr "WCPOS Pro leyfið þitt er útrunnið"

msgid "You do not have permission to manage plugins."
msgstr "Þú hefur ekki heimild til að stjórna viðbótum."

