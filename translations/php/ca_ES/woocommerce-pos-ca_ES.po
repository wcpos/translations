#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> requereix <a href=\"%1$s\">WooCommerce %2$s o "
"superior</a>. Si us plau, <a href=\"%3$s\">instal·la i activa "
"WooCommerce</a>"

