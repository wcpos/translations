#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Punt de Venda per a WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. Requires <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Una interfície senzilla per a gestionar comandes de WooCommerce al Punt de Venda. Requereix <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> requereix PHP %1$s o superior. Llegeix més informació sobre <a href=\"%2$s\">com pots actualitzar</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> requereix <a href=\"%1$s\">WooCommerce %2$s o superior</a>. Si us plau, <a href=\"%3$s\">instal·la i activa WooCommerce</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> requereix enllaços permanents <em>bonics</em> per funcionar correctament"

msgid "Enable permalinks"
msgstr "Activa els enllaços permanents"

