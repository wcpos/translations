msgid "Loading&#8230;"
msgstr "Carregant&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "Seleccioneu els usuaris autoritzats per accedir a aquesta botiga."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"Nota: només estaran disponibles per a la selecció els usuaris amb els privilegis adequats. <a href=\"%s\" target=\"_blank\">Consulteu la documentació per a més detalls.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Adreça Web"

#. translators: wordpress
msgid "Email"
msgstr "Correu Electrònic"

msgid "Opening Hours notes"
msgstr "Notes de l'Horari d'Obertura"

msgid "eg: Closed public holidays"
msgstr "p. ex.: Tancat festius"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Podeu afegir l'horari d'obertura al vostre lloc web mitjançant un widget. <a href=\"%s\">Llegiu la documentació</a> per a més informació."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"Si us plau, <a href=\"%s\">llegiu la documentació</a> per obtenir informació sobre com personalitzar els vostres rebuts de POS."

msgid "Enable store price field"
msgstr "Habilitar camp de preu de la botiga"

msgid "Complimentary Close"
msgstr "Tancament Complementari"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"Notes personals o salutacions de temporada, p. ex.: Gràcies per la vostra comanda! o Bon Nadal!"

msgid "Returns Policy"
msgstr "Política de Devolucions"

msgid "Returns policy, terms and conditions"
msgstr "Política de devolucions, termes i condicions"

msgid "Footer"
msgstr "Peu de pàgina"

msgid "Further footer information, e.g. copyright or branding"
msgstr "Més informació del peu de pàgina, p. ex.: drets d'autor o marca"

msgid "Calculate Tax Based On"
msgstr "Calcular l'Impost Basat En"

msgid "this store address"
msgstr "aquesta adreça de botiga"

msgid "base location"
msgstr "ubicació base"

msgid "No tax rates set"
msgstr "No s'han establert taxes d'impost"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Les taxes d'impost anteriors s'utilitzaran al punt de venda. Podeu <a href=\"%s\">canviar la taxa d'impost</a> a la configuració de WooCommerce."

msgid "POS Barcode"
msgstr "Codi de barres POS"

msgid "Product barcode used at the point of sale"
msgstr "Codi de barres del producte utilitzat al punt de venda"

msgid "Something went wrong. Please try again later."
msgstr "Alguna cosa ha anat malament. Torna-ho a provar més tard."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Instal·lació del complement"

msgid "Your WCPOS Pro license is valid and active."
msgstr "La teva llicència de WCPOS Pro és vàlida i activa."

msgid "You are receiving plugin updates."
msgstr "Estàs rebent actualitzacions del complement."

msgid "Your WCPOS Pro license is inactive."
msgstr "La teva llicència de WCPOS Pro està inactiva."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr ""
"<a href=\"%s\">Fes clic aquí</a> per activar la teva clau de llicència."

msgid "Your WCPOS Pro license has expired."
msgstr "La teva llicència de WCPOS Pro ha caducat."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Si us plau, renova</a> per rebre actualitzacions."

msgid "Your WCPOS Pro license is inactive"
msgstr "La teva llicència de WCPOS Pro està inactiva"

msgid "Your WCPOS Pro license has expired"
msgstr "La teva llicència de WCPOS Pro ha caducat"

msgid "You do not have permission to manage plugins."
msgstr "No tens permís per gestionar complements."

#. translators: %s: extension slug
#, php-format
msgid "Extension \"%s\" not found in catalog."
msgstr "L'extensió \"%s\" no s'ha trobat al catàleg."

msgid "Invalid action."
msgstr "Acció no vàlida."

msgid "No download URL available for this extension."
msgstr "No hi ha cap URL de descàrrega disponible per a aquesta extensió."

msgid "Plugin installation failed."
msgstr "La instal·lació del complement ha fallat."

msgid "Plugin was installed but could not be located."
msgstr "El complement s'ha instal·lat però no s'ha pogut localitzar."

msgid "Extension is not installed."
msgstr "L'extensió no està instal·lada."

msgid "Plugin update failed."
msgstr "L'actualització del complement ha fallat."

msgid "You do not have permission to manage stores."
msgstr "No tens permís per gestionar botigues."

msgid "Store not found."
msgstr "Botiga no trobada."

msgid "Failed to trash store."
msgstr "No s'ha pogut eliminar la botiga."

msgid "Failed to save settings."
msgstr "No s'han pogut desar les configuracions."

msgid "Add New Store"
msgstr "Afegeix nova botiga"

msgid "New Store"
msgstr "Nova botiga"

msgid "View Store"
msgstr "Visualitza botiga"

msgid "Search Stores"
msgstr "Cerca botigues"

msgid "Parent Store:"
msgstr "Botiga principal:"

msgid "No Stores found."
msgstr "No s'han trobat botigues."

msgid "No Stores found in Trash."
msgstr "No s'han trobat botigues a la paperera."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr ""
"No s'ha pogut carregar WCPOS Pro. Si us plau, executa composer install."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin has been automatically deactivated. You may safely delete it from your plugins."
msgstr ""
"ara inclou totes les funcions del complement gratuït. El complement gratuït independent s'ha desactivat automàticament. Pots eliminar-lo de manera segura dels teus complements."
