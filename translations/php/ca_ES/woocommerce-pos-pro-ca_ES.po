#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – Punt de Venda per WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"Una solució completa de Punt de Venda per WooCommerce. Pro inclou totes les funcions del complement gratuït més suport per a múltiples botigues, rebuts personalitzats i més."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "Botigues"

msgid "Cashiers"
msgstr "Caixers"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS Pro ara és independent."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"El complement Pro inclou totes les funcions de la versió gratuïta. Podeu desactivar i eliminar aquest complement amb seguretat."

msgid "Edit Store"
msgstr "Edita botiga"

msgctxt "All authorized users"
msgid "All"
msgstr "Tot"

