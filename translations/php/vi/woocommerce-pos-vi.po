msgid "Sorry, this order is invalid and cannot be paid for."
msgstr "Xin lỗi, đơn hàng này không hợp lệ và không thể thanh toán."

msgid "Sorry, this order has already been paid for."
msgstr "Xin lỗi, đơn hàng này đã được thanh toán."

