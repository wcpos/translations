msgstr "Lỗi hóa đơn"

msgid "Receipt Template Error"
msgstr "Lỗi mẫu hóa đơn"

msgid ""
"There was a problem rendering the receipt template. This is usually caused "
"by a syntax error or undefined variable in the template code."
msgstr ""
"Có vấn đề khi hiển thị mẫu hóa đơn. Thường do lỗi cú pháp hoặc biến không "
"xác định trong mã mẫu."

msgid "File:"
msgstr "Tệp tin:"

msgid "Line:"
msgstr "Dòng:"

msgid "Suggestions:"
msgstr "Đề xuất:"

msgid ""
"Check the template file for syntax errors (missing semicolons, brackets, "
"etc.)"
msgstr ""
"Kiểm tra tệp tin mẫu để tìm lỗi cú pháp (thiếu dấu chấm phẩy, dấu ngoặc, "
"v.v.)"

msgid "Ensure all variables used in the template are defined"
msgstr "Đảm bảo tất cả các biến được sử dụng trong mẫu đều được định nghĩa"

msgid "Verify that any custom functions or classes exist"
msgstr "Xác minh rằng các hàm hoặc lớp tùy chỉnh có tồn tại"

msgid "Try resetting to the default receipt template"
msgstr "Thử đặt lại mẫu hóa đơn mặc định"

msgid "Please contact the site administrator for assistance."
msgstr "Vui lòng liên hệ quản trị viên trang để được hỗ trợ."

msgid "Invalid template language."
msgstr "Ngôn ngữ mẫu không hợp lệ."

