#. translators: wordpress
msgid "Loading&#8230;"
msgstr "Đang tải&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "Chọn người dùng được ủy quyền truy cập cửa hàng này."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"Lưu ý: chỉ những người dùng có quyền hạn thích hợp mới có thể được chọn. <a "
"href=\"%s\" target=\"_blank\">Xem tài liệu để biết chi tiết.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Địa chỉ web"

#. translators: wordpress
msgid "Email"
msgstr "Email"

msgid "Opening Hours notes"
msgstr "Ghi chú giờ mở cửa"

msgid "eg: Closed public holidays"
msgstr "ví dụ: Đóng cửa vào các ngày lễ"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Bạn có thể thêm giờ mở cửa vào trang web của mình bằng cách sử dụng widget. "
"<a href=\"%s\">Đọc tài liệu</a> để biết thêm thông tin."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"Vui lòng <a href=\"%s\">đọc tài liệu</a> để biết thông tin về cách tùy "
"chỉnh hóa đơn POS của bạn."

msgid "Enable store price field"
msgstr "Kích hoạt trường giá cửa hàng"

msgid "Complimentary Close"
msgstr "Lời chào kết thúc"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr ""
"Ghi chú cá nhân hoặc lời chào theo mùa, ví dụ: Cảm ơn bạn đã đặt hàng! hoặc "
"Giáng sinh vui vẻ!"

msgid "Returns Policy"
msgstr "Chính sách hoàn trả"

msgid "Returns policy, terms and conditions"
msgstr "Chính sách hoàn trả, điều khoản và điều kiện"

msgid "Footer"
msgstr "Chân trang"

msgid "Further footer information, e.g. copyright or branding"
msgstr "Thông tin chân trang thêm, ví dụ: bản quyền hoặc thương hiệu"

msgid "Calculate Tax Based On"
msgstr "Tính thuế dựa trên"

msgid "this store address"
msgstr "địa chỉ cửa hàng này"

msgid "base location"
msgstr "vị trí cơ sở"

msgid "No tax rates set"
msgstr "Chưa thiết lập mức thuế"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Các mức thuế trên sẽ được sử dụng tại điểm bán hàng. Bạn có thể <a "
"href=\"%s\">thay đổi mức thuế</a> trong cài đặt WooCommerce."

msgid "POS Barcode"
msgstr "Mã vạch POS"

msgid "Product barcode used at the point of sale"
msgstr "Mã vạch sản phẩm dùng tại điểm bán hàng"

msgid "Something went wrong. Please try again later."
msgstr "Đã xảy ra lỗi. Vui lòng thử lại sau."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Cài đặt Plugin"

msgid "Your WCPOS Pro license is valid and active."
msgstr "Giấy phép WCPOS Pro của bạn hợp lệ và đang hoạt động."

msgid "You are receiving plugin updates."
msgstr "Bạn đang nhận cập nhật plugin."

msgid "Your WCPOS Pro license is inactive."
msgstr "Giấy phép WCPOS Pro của bạn không hoạt động."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">Nhấn vào đây</a> để kích hoạt khóa giấy phép của bạn."

msgid "Your WCPOS Pro license has expired."
msgstr "Giấy phép WCPOS Pro của bạn đã hết hạn."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Vui lòng gia hạn</a> để nhận cập nhật."

msgid "Your WCPOS Pro license is inactive"
msgstr "Giấy phép WCPOS Pro của bạn không hoạt động"

msgid "Your WCPOS Pro license has expired"
msgstr "Giấy phép WCPOS Pro của bạn đã hết hạn"

msgid "You do not have permission to manage plugins."
msgstr "Bạn không có quyền quản lý plugin."

