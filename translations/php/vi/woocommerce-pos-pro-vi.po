msgstr "Thông tin liên hệ"

msgid "Receipt Options"
msgstr "Tùy chọn hóa đơn"

msgid "Set featured image"
msgstr "Đặt hình ảnh nổi bật"

msgid "Set store logo"
msgstr "Đặt logo cửa hàng"

msgid "Remove featured image"
msgstr "Xóa hình ảnh nổi bật"

msgid "Remove store logo"
msgstr "Xóa logo cửa hàng"

msgid "Set Store Logo"
msgstr "Đặt Logo Cửa hàng"

