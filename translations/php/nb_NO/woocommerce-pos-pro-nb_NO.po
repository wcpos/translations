msgstr "Beregn skatt basert på"

msgid "this store address"
msgstr "denne butikkadressen"

msgid "base location"
msgstr "baselokasjon"

msgid "No tax rates set"
msgstr "Ingen skattesatser satt"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Skattesatsene ovenfor vil bli brukt ved salgspunktet. Du kan <a "
"href=\"%s\">endre skattesatsen</a> i WooCommerce-innstillingene."

msgid "POS Barcode"
msgstr "POS strekkode"

msgid "Product barcode used at the point of sale"
msgstr "Produktstrekkode brukt ved salgsstedet"

msgid "Something went wrong. Please try again later."
msgstr "Noe gikk galt. Vennligst prøv igjen senere."

