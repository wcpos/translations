msgid "Web Address"
msgstr "Nettadresse"

#. translators: wordpress
msgid "Email"
msgstr "E-post"

msgid "Opening Hours notes"
msgstr "Notater om åpningstider"

msgid "eg: Closed public holidays"
msgstr "f.eks.: Stengt på offentlige helligdager"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Du kan legge til åpningstider på nettstedet ditt ved å bruke en widget. <a "
"href=\"%s\">Les dokumentasjonen</a> for mer informasjon."

#. translators: %s: documentation URL.
#, php-format
