msgstr "Λείπει ή είναι άκυρη η παράμετρος redirect_uri."

msgid "Missing state parameter."
msgstr "Λείπει η παράμετρος state."

msgid "Too many requests. Please try again later."
msgstr "Πάρα πολλά αιτήματα. Παρακαλώ δοκιμάστε ξανά αργότερα."

msgid "Auth session expired. Please try logging in again from the app."
msgstr ""
"Η συνεδρία αυθεντικοποίησης έληξε. Παρακαλώ δοκιμάστε να συνδεθείτε ξανά "
"από την εφαρμογή."

msgid "Invalid auth session. Please try logging in again from the app."
msgstr ""
"Άκυρη συνεδρία αυθεντικοποίησης. Παρακαλώ δοκιμάστε να συνδεθείτε ξανά από "
"την εφαρμογή."

msgid "Security check failed. Please try again."
msgstr "Η επαλήθευση ασφαλείας απέτυχε. Παρακαλώ προσπαθήστε ξανά."

msgid "Authentication failed."
msgstr "Η αυθεντικοποίηση απέτυχε."

msgid ""
"This account is temporarily locked due to too many failed login attempts. "
"Please try again later."
msgstr ""
"Αυτός ο λογαριασμός είναι προσωρινά κλειδωμένος λόγω πολλών αποτυχημένων "
"προσπαθειών σύνδεσης. Παρακαλώ προσπαθήστε ξανά αργότερα."

msgid "Failed to generate authentication tokens."
msgstr "Απέτυχε η δημιουργία διακριτικών αυθεντικοποίησης."

msgid "Please enter both username and password."
msgstr "Παρακαλώ εισάγετε και το όνομα χρήστη και τον κωδικό πρόσβασης."

msgid "Invalid username or password."
msgstr "Μη έγκυρο όνομα χρήστη ή κωδικός πρόσβασης."

