#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Σημείο Πώλησης για WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. Requires <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Ένα απλό front-end για λήψη παραγγελιών WooCommerce στο Σημείο Πώλησης. Απαιτεί <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> απαιτεί PHP %1$s ή νεότερο. Διαβάστε περισσότερες πληροφορίες για <a href=\"%2$s\">το πώς μπορείτε να ενημερώσετε</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> απαιτεί <a href=\"%1$s\">WooCommerce %2$s ή νεότερο</a>. Παρακαλώ <a href=\"%3$s\">εγκαταστήστε και ενεργοποιήστε το WooCommerce</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> απαιτεί <em>όμορφα</em> permalinks για να λειτουργήσει σωστά"

msgid "Enable permalinks"
msgstr "Ενεργοποίηση permalinks"

msgid "Cashier"
msgstr "Ταμίας"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> απαιτεί <a href=\"%1$s\">WCPOS Pro %2$s ή νεότερο</a>. Παρακαλώ <a href=\"%3$s\">εγκαταστήστε και ενεργοποιήστε το WCPOS Pro</a>"

