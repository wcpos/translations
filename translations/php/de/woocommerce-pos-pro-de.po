msgstr "Das Terminal hat die Zahlung abgelehnt oder abgebrochen."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:81
msgid "Card declined."
msgstr "Karte abgelehnt."

#: includes/Payments/OrderPay/Order_Pay_Panel.php:82
