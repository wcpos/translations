msgstr "वह उपयोगकर्ता ID जो सत्र का मालिक है।"

msgid "Missing required parameters."
msgstr "आवश्यक पैरामीटर गायब हैं।"

msgid "Session revoked successfully."
msgstr "सत्र सफलतापूर्वक निरस्त किया गया।"

msgid "Failed to revoke session."
msgstr "सत्र निरस्त करने में विफल।"

