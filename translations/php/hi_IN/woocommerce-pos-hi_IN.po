#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – WooCommerce के लिए पॉइंट ऑफ सेल"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"पॉइंट ऑफ सेल पर WooCommerce ऑर्डर लेने के लिए एक सरल फ्रंट-एंड। इसके लिए <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a> आवश्यक "
"है।"

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> के लिए PHP %1$s या उससे अधिक की आवश्यकता है। <a "
"href=\"%2$s\">कैसे अपडेट करें</a> के बारे में अधिक जानकारी पढ़ें"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> के लिए <a href=\"%1$s\">WooCommerce %2$s या उससे "
"अधिक</a> की आवश्यकता है। कृपया <a href=\"%3$s\">WooCommerce इंस्टॉल और "
"सक्रिय करें</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> को सही से काम करने के लिए "
"<em>सुंदर</em> पर्मालिंक्स की आवश्यकता है"

msgid "Enable permalinks"
msgstr "पर्मालिंक्स सक्षम करें"

msgid "Cashier"
msgstr "कैशियर"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> के लिए <a href=\"%1$s\">WCPOS Pro %2$s या उससे "
"अधिक</a> की आवश्यकता है। कृपया <a href=\"%3$s\">WCPOS Pro इंस्टॉल और सक्रिय "
"करें</a>"

