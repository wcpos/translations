#, php-format
msgid "PHP syntax error: %s"
msgstr "PHP सिंटैक्स त्रुटि: %s"

msgid "PHP syntax error: Mismatched PHP tags."
msgstr "PHP सिंटैक्स त्रुटि: PHP टैग मेल नहीं खा रहे।"

#. translators: %s: function name.
#, php-format
msgid ""
"Template contains dangerous function: %s(). This function is not allowed for security reasons."
msgstr ""
"टेम्पलेट में खतरनाक फ़ंक्शन है: %s(). सुरक्षा कारणों से इस फ़ंक्शन की अनुमति नहीं है।"

msgid "A message for you"
msgstr "आपके लिए एक संदेश"

