msgstr "बार टिकट"

msgid "Order"
msgstr "आदेश"

msgid "Missing or invalid redirect_uri parameter."
msgstr "गायब या अमान्य redirect_uri पैरामीटर।"

msgid "Missing state parameter."
msgstr "गायब राज्य पैरामीटर।"

msgid "Too many requests. Please try again later."
msgstr "बहुत अधिक अनुरोध। कृपया बाद में पुनः प्रयास करें।"

msgid "Auth session expired. Please try logging in again from the app."
msgstr ""
"प्रमाणीकरण सत्र समाप्त हो गया। कृपया ऐप से फिर से लॉगिन करने का प्रयास करें।"

msgid "Invalid auth session. Please try logging in again from the app."
msgstr "अमान्य प्रमाणीकरण सत्र। कृपया ऐप से फिर से लॉगिन करने का प्रयास करें।"

msgid "Security check failed. Please try again."
msgstr "सुरक्षा जांच विफल रही। कृपया पुनः प्रयास करें।"

msgid "Authentication failed."
msgstr "प्रमाणीकरण विफल रहा।"

msgid ""
"This account is temporarily locked due to too many failed login attempts. Please try again later."
msgstr ""
"बहुत अधिक विफल लॉगिन प्रयासों के कारण यह खाता अस्थायी रूप से बंद है। कृपया बाद में पुनः प्रयास करें।"

msgid "Failed to generate authentication tokens."
msgstr "प्रमाणीकरण टोकन उत्पन्न करने में विफल।"

msgid "Please enter both username and password."
msgstr "कृपया उपयोगकर्ता नाम और पासवर्ड दोनों दर्ज करें।"

msgid "Invalid username or password."
msgstr "अमान्य उपयोगकर्ता नाम या पासवर्ड।"

#. translators: wordpress.
msgid "You do not have sufficient permissions to access this page."
msgstr "आपके पास इस पृष्ठ तक पहुंचने की पर्याप्त अनुमति नहीं है।"

msgid ""
"Sorry, this order cannot be paid for. The order key is missing or invalid."
msgstr ""
"क्षमा करें, इस आदेश का भुगतान नहीं किया जा सकता है। आदेश कुंजी अनुपस्थित है या अमान्य है।"

msgid ""
"This order cannot be paid for. Please contact us if you need assistance."
msgstr ""
"इस आदेश का भुगतान नहीं किया जा सकता। यदि आपको सहायता की आवश्यकता है, तो कृपया हमसे संपर्क करें।"

msgid "Pay for order"
msgstr "आदेश का भुगतान करें"

msgid "Checkout Settings"
msgstr "चेकआउट सेटिंग्स"

msgid ""
"Scripts and styles may interfere with the custom payment template, use this form to dequeue any problematic scripts."
msgstr ""
"स्क्रिप्ट और शैलियाँ कस्टम भुगतान टेम्पलेट में हस्तक्षेप कर सकती हैं, किसी भी समस्याग्रस्त स्क्रिप्ट को हटाने के लिए इस फॉर्म का उपयोग करें।"

msgid "Disable All Styles and Scripts"
msgstr "सभी शैलियाँ और स्क्रिप्ट अक्षम करें"

msgid "Disable wp_head"
msgstr "wp_head अक्षम करें"

msgid "Disable wp_footer"
msgstr "wp_footer अक्षम करें"

msgid "Disable Selected Styles"
msgstr "चयनित शैलियाँ अक्षम करें"

msgid "Disable Selected Scripts"
msgstr "चयनित स्क्रिप्ट अक्षम करें"

msgid "Submit"
msgstr "प्रस्तुत करें"

msgid "Paying as customer"
msgstr "ग्राहक के रूप में भुगतान"

msgid "Sorry, this order is invalid and cannot be paid for."
msgstr "क्षमा करें, यह आदेश अमान्य है और इसका भुगतान नहीं किया जा सकता।"

msgid "Sorry, this order has already been paid for."
msgstr "क्षमा करें, इस आदेश का पहले ही भुगतान किया जा चुका है।"

msgid "You do not have permission to modify checkout settings."
msgstr "आपके पास चेकआउट सेटिंग्स में परिवर्तन करने की अनुमति नहीं है।"

msgid "Sorry, this order is invalid."
msgstr "क्षमा करें, यह आदेश अमान्य है।"

msgid "You do not have permission to view this receipt."
msgstr "आपके पास इस रसीद को देखने की अनुमति नहीं है।"

msgid "Receipt Error"
msgstr "रसीद त्रुटि"

msgid "Receipt Template Error"
msgstr "रसीद टेम्पलेट त्रुटि"

msgid ""
"There was a problem rendering the receipt template. This is usually caused by a syntax error or undefined variable in the template code."
msgstr ""
"रसीद टेम्पलेट प्रस्तुत करने में समस्या थी। यह आमतौर पर टेम्पलेट कोड में सिंटैक्स त्रुटि या अपरिभाषित वेरिएबल के कारण होता है।"

msgid "File:"
msgstr "फ़ाइल:"

msgid "Line:"
msgstr "पंक्ति:"

msgid "Suggestions:"
msgstr "सुझाव:"

msgid ""
"Check the template file for syntax errors (missing semicolons, brackets, etc.)"
msgstr ""
"टेम्पलेट फ़ाइल में सिंटैक्स त्रुटियों की जाँच करें (लापता सेमीकोलन, ब्रैकेट, आदि)।"

msgid "Ensure all variables used in the template are defined"
msgstr "सुनिश्चित करें कि टेम्पलेट में उपयोग किए गए सभी वेरिएबल परिभाषित हैं"

msgid "Verify that any custom functions or classes exist"
msgstr "सुनिश्चित करें कि कोई भी कस्टम फ़ंक्शन या क्लास मौजूद हैं"

msgid "Try resetting to the default receipt template"
msgstr "डिफ़ॉल्ट रसीद टेम्पलेट पर रीसेट करने का प्रयास करें"

msgid "Please contact the site administrator for assistance."
msgstr "कृपया सहायता के लिए साइट व्यवस्थापक से संपर्क करें।"

msgid ""
"Sorry, this order cannot be viewed. The order key is missing or invalid."
msgstr ""
"क्षमा करें, आप इस आदेश का दर्शन नहीं कर सकते। आदेश कुंजी अनुपस्थित है या अमान्य है।"

msgid "Failed to create temporary template file."
msgstr "अस्थाई टेम्पलेट फ़ाइल बनाने में विफल।"

msgid "Invalid template language."
msgstr "अमान्य टेम्पलेट भाषा।"

