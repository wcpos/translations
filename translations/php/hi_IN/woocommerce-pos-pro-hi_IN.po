#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS प्रो – WooCommerce के लिए पॉइंट ऑफ़ सेल"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all "
"features from the free plugin plus multi-store support, custom receipts, "
"and more."
msgstr ""
"WooCommerce के लिए एक संपूर्ण पॉइंट ऑफ़ सेल समाधान। प्रो में मुफ्त प्लगइन "
"की सभी विशेषताएं शामिल हैं, साथ ही मल्टी-स्टोर समर्थन, कस्टम रसीदें, और भी "
"बहुत कुछ।"

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "स्टोर"

msgid "Cashiers"
msgstr "कैशियर"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS प्रो अब स्वतंत्र है।"

msgid ""
"The Pro plugin includes all features from the free version. You can safely "
"deactivate and delete this plugin."
msgstr ""
"प्रो प्लगइन में मुफ्त संस्करण की सभी विशेषताएं शामिल हैं। आप इस प्लगइन को "
"सुरक्षित रूप से निष्क्रिय और हटा सकते हैं।"

msgid "Open POS"
msgstr "POS खोलें"

msgid "Store"
msgstr "स्टोर"

