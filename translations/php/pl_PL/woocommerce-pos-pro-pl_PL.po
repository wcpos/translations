#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – Punkt sprzedaży dla WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"Kompletne rozwiązanie punktu sprzedaży dla WooCommerce. Wersja Pro zawiera wszystkie funkcje z darmowej wtyczki oraz obsługę wielu sklepów, niestandardowe paragony i więcej."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "Sklepy"

msgid "Cashiers"
msgstr "Kasjerzy"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS Pro jest teraz samodzielny."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"Wtyczka Pro zawiera wszystkie funkcje z darmowej wersji. Możesz bezpiecznie dezaktywować i usunąć tę wtyczkę."

msgid "Edit Store"
msgstr "Edytuj sklep"

msgid "All"
msgstr "Wszyscy"

msgid "Open POS"
msgstr "Otwórz POS"

msgid "Store"
msgstr "Sklep"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "Autoryzowani użytkownicy"

msgid "Opening Hours"
msgstr "Godziny otwarcia"

msgid "Logo"
msgstr "Logo"

#. translators: wordpress.
msgid "Contact Info"
msgstr "Informacje kontaktowe"

msgid "Receipt Options"
msgstr "Opcje paragonu"

msgid "Set featured image"
msgstr "Ustaw wyróżniony obraz"

msgid "Set store logo"
msgstr "Ustaw logo sklepu"

msgid "Remove featured image"
msgstr "Usuń wyróżniony obraz"

msgid "Remove store logo"
msgstr "Usuń logo sklepu"

msgid "Set Store Logo"
msgstr "Ustaw logo sklepu"

#. translators: wordpress.
msgid "Monday"
msgstr "Poniedziałek"

#. translators: wordpress.
msgid "Tuesday"
msgstr "Wtorek"

#. translators: wordpress.
msgid "Wednesday"
msgstr "Środa"

#. translators: wordpress.
msgid "Thursday"
msgstr "Czwartek"

#. translators: wordpress.
msgid "Friday"
msgstr "Piątek"

#. translators: wordpress.
