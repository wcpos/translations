#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Продажба за WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. Requires <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Едноставен интерфејс за примање нарачки во WooCommerce на местото на продажба. Потребен е <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> бара PHP %1$s или повисока верзија. Прочитајте повеќе информации за <a href=\"%2$s\">како да ажурирате</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> бара <a href=\"%1$s\">WooCommerce %2$s или повисока верзија</a>. Ве молиме <a href=\"%3$s\">инсталирајте и активирајте WooCommerce</a>"

