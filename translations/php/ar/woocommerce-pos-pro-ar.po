#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro - نقطة بيع لـ WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"حل كامل لنقطة البيع لـ WooCommerce. يتضمن Pro جميع الميزات من الإضافة المجانية بالإضافة إلى دعم متعدد المتاجر وإيصالات مخصصة والمزيد."

#. Author of the plugin
msgid "kilbot"
msgstr "كيلبوت"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "المتاجر"

msgid "Cashiers"
msgstr "الصرافون"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "أصبح WooCommerce POS Pro الآن مستقلًا."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"تتضمن إضافة Pro جميع الميزات من النسخة المجانية. يمكنك تعطيل وحذف هذه الإضافة بأمان."

msgid "Edit Store"
msgstr "تحرير المتجر"

msgid "All"
msgstr "الكل"

msgid "Open POS"
msgstr "فتح نقطة البيع"

msgid "Store"
msgstr "المتجر"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "المستخدمون المصرح لهم"

msgid "Opening Hours"
msgstr "ساعات العمل"

msgid "Logo"
msgstr "الشعار"

#. translators: wordpress.
msgid "Contact Info"
msgstr "معلومات الاتصال"

msgid "Receipt Options"
msgstr "خيارات الإيصال"

msgid "Set featured image"
msgstr "تعيين الصورة المميزة"

msgid "Set store logo"
msgstr "تعيين شعار المتجر"

msgid "Remove featured image"
msgstr "إزالة الصورة المميزة"

msgid "Remove store logo"
msgstr "إزالة شعار المتجر"

msgid "Set Store Logo"
msgstr "تعيين شعار المتجر"

#. translators: wordpress.
msgid "Monday"
msgstr "الإثنين"

#. translators: wordpress.
msgid "Tuesday"
msgstr "الثلاثاء"

#. translators: wordpress.
msgid "Wednesday"
msgstr "الأربعاء"

#. translators: wordpress.
msgid "Thursday"
msgstr "الخميس"

#. translators: wordpress.
msgid "Friday"
msgstr "الجمعة"

#. translators: wordpress.
msgid "Saturday"
msgstr "السبت"

#. translators: wordpress.
msgid "Sunday"
msgstr "الأحد"

#. translators: wordpress
msgid "Loading&#8230;"
msgstr "جارٍ التحميل&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "اختر المستخدمين المصرح لهم بالوصول إلى هذا المتجر."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"ملاحظة: سيكون متاحًا للاختيار فقط المستخدمون الذين لديهم الامتيازات المناسبة. <a href=\"%s\" target=\"_blank\">انظر الوثائق للتفاصيل.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "عنوان الويب"

#. translators: wordpress
msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Opening Hours notes"
msgstr "ملاحظات ساعات العمل"

msgid "eg: Closed public holidays"
msgstr "مثال: مغلق في العطلات الرسمية"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"يمكنك إضافة ساعات العمل إلى موقعك باستخدام عنصر واجهة. <a href=\"%s\">اقرأ الوثائق</a> لمزيد من المعلومات."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"يرجى <a href=\"%s\">قراءة الوثائق</a> للحصول على معلومات حول كيفية تخصيص إيصالات نقطة البيع الخاصة بك."

msgid "Enable store price field"
msgstr "تمكين حقل سعر المتجر"

msgid "Complimentary Close"
msgstr "إغلاق تكميلي"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr "ملاحظات شخصية أو تحيات موسمية، مثل: شكرًا لطلبك! أو عيد ميلاد مجيد!"

msgid "Returns Policy"
msgstr "سياسة الإرجاع"

msgid "Returns policy, terms and conditions"
msgstr "سياسة الإرجاع، الشروط والأحكام"

msgid "Footer"
msgstr "التذييل"

msgid "Further footer information, e.g. copyright or branding"
msgstr "معلومات إضافية في التذييل، مثل حقوق الطبع أو العلامة التجارية"

msgid "Calculate Tax Based On"
msgstr "حساب الضريبة بناءً على"

msgid "this store address"
msgstr "عنوان هذا المتجر"

msgid "base location"
msgstr "الموقع الأساسي"

msgid "No tax rates set"
msgstr "لم يتم تعيين معدلات ضريبية"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"سيتم استخدام معدلات الضريبة المذكورة أعلاه في نقطة البيع. يمكنك <a href=\"%s\">تغيير معدل الضريبة</a> في إعدادات WooCommerce."

msgid "POS Barcode"
msgstr "الباركود لنقطة البيع"

msgid "Product barcode used at the point of sale"
msgstr "باركود المنتج المستخدم في نقطة البيع"

msgid "Something went wrong. Please try again later."
msgstr "حدث خطأ ما. يرجى المحاولة مرة أخرى لاحقًا."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "تثبيت الإضافة"

msgid "Your WCPOS Pro license is valid and active."
msgstr "ترخيص WCPOS Pro الخاص بك صالح ونشط."

msgid "You are receiving plugin updates."
msgstr "أنت تتلقى تحديثات الإضافة."

msgid "Your WCPOS Pro license is inactive."
msgstr "ترخيص WCPOS Pro الخاص بك غير نشط."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">اضغط هنا</a> لتفعيل مفتاح الترخيص الخاص بك."

msgid "Your WCPOS Pro license has expired."
msgstr "انتهت صلاحية ترخيص WCPOS Pro الخاص بك."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">يرجى التجديد</a> لتلقي التحديثات."

msgid "Your WCPOS Pro license is inactive"
msgstr "ترخيص WCPOS Pro الخاص بك غير نشط"

msgid "Your WCPOS Pro license has expired"
msgstr "انتهت صلاحية ترخيص WCPOS Pro الخاص بك"

msgid "You do not have permission to manage plugins."
msgstr "ليس لديك إذن لإدارة الإضافات."

#. translators: %s: extension slug
#, php-format
msgid "Extension \"%s\" not found in catalog."
msgstr "الإضافة \"%s\" غير موجودة في الكتالوج."

msgid "Invalid action."
msgstr "إجراء غير صالح."

msgid "No download URL available for this extension."
msgstr "لا يوجد رابط تحميل متاح لهذه الإضافة."

msgid "Plugin installation failed."
msgstr "فشل تثبيت الإضافة."

msgid "Plugin was installed but could not be located."
msgstr "تم تثبيت الإضافة ولكن لم يتم العثور عليها."

msgid "Extension is not installed."
msgstr "الإضافة غير مثبتة."

msgid "Plugin update failed."
msgstr "فشل تحديث الإضافة."

msgid "You do not have permission to manage stores."
msgstr "ليس لديك إذن لإدارة المتاجر."

msgid "Store not found."
msgstr "لم يتم العثور على المتجر."

msgid "Failed to trash store."
msgstr "فشل في حذف المتجر."

msgid "Failed to save settings."
msgstr "فشل في حفظ الإعدادات."

msgid "Add New Store"
msgstr "إضافة متجر جديد"

msgid "New Store"
msgstr "متجر جديد"

msgid "View Store"
msgstr "عرض المتجر"

msgid "Search Stores"
msgstr "البحث في المتاجر"

msgid "Parent Store:"
msgstr "المتجر الرئيسي:"

msgid "No Stores found."
msgstr "لم يتم العثور على متاجر."

msgid "No Stores found in Trash."
msgstr "لم يتم العثور على متاجر في سلة المهملات."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "فشل تحميل WCPOS Pro. يرجى تشغيل composer install."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin has been automatically deactivated. You may safely delete it from your plugins."
msgstr ""
"الآن يتضمن جميع الميزات من الإضافة المجانية. تم إلغاء تفعيل الإضافة المجانية المستقلة تلقائيًا. يمكنك حذفها بأمان من إضافاتك."
