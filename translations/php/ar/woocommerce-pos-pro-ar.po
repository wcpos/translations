#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro - نقطة بيع لـ WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all "
"features from the free plugin plus multi-store support, custom receipts, "
"and more."
msgstr ""
"حل كامل لنقطة البيع لـ WooCommerce. يتضمن الإصدار Pro جميع الميزات من "
"الإضافة المجانية بالإضافة إلى دعم المتاجر المتعددة والإيصالات المخصصة "
"والمزيد."

#. Author of the plugin
msgid "kilbot"
msgstr "كيلبوت"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "المتاجر"

msgid "Cashiers"
msgstr "الصرافون"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "أصبح WooCommerce POS Pro الآن مستقلًا."

msgid ""
"The Pro plugin includes all features from the free version. You can safely "
"deactivate and delete this plugin."
msgstr ""
"تتضمن إضافة Pro جميع الميزات من الإصدار المجاني. يمكنك إلغاء تفعيل وحذف هذه "
"الإضافة بأمان."

msgid "Open POS"
msgstr "فتح نقطة البيع"

msgid "Store"
msgstr "المتجر"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "المستخدمون المصرح لهم"

msgid "Opening Hours"
msgstr "ساعات العمل"

msgid "Logo"
msgstr "الشعار"

#. translators: wordpress.
msgid "Contact Info"
msgstr "معلومات الاتصال"

msgid "Receipt Options"
msgstr "خيارات الإيصال"

msgid "Set featured image"
msgstr "تعيين الصورة المميزة"

msgid "Set store logo"
msgstr "تعيين شعار المتجر"

msgid "Remove featured image"
msgstr "إزالة الصورة المميزة"

msgid "Remove store logo"
msgstr "إزالة شعار المتجر"

msgid "Set Store Logo"
msgstr "تعيين شعار المتجر"

