#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> requer <a href=\"%1$s\">WooCommerce %2$s ou "
"superior</a>. Por favor, <a href=\"%3$s\">instale e ative o WooCommerce</a>"

