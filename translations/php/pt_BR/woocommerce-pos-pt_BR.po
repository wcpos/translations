#: includes/Templates/Gallery_Registry.php:500
msgid ""
"Right-to-left version of the Standard Receipt for Arabic, Hebrew, Persian and Urdu sites. Mirrors layout and uses an RTL-friendly font stack."
msgstr ""
"Versão da direita para a esquerda do Recibo padrão para sites em árabe, hebraico, persa e urdu. Espelha o layout e usa uma pilha de fontes amigável para RTL."

#. translators: Gallery template name shown in the admin Template Gallery.
#: includes/Templates/Gallery_Registry.php:512
msgid "Detailed Thermal Receipt (58mm)"
msgstr "Recibo térmico detalhado (58mm)"

#. translators: Gallery template description shown in the admin Template Gallery.
#: includes/Templates/Gallery_Registry.php:514
msgid ""
"Kitchen-sink 58mm receipt: full customer + addresses, tax breakdown, refunds, payments, terms and order barcode."
msgstr ""
"Recibo 58mm completo: cliente + endereços, detalhamento de impostos, reembolsos, pagamentos, termos e código de barras do pedido."

#. translators: Gallery template name shown in the admin Template Gallery.
#: includes/Templates/Gallery_Registry.php:525
