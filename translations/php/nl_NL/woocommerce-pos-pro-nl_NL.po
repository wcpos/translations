msgstr "Geen belastingtarieven ingesteld"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"De bovenstaande belastingtarieven worden gebruikt bij het verkooppunt. U "
"kunt de <a href=\"%s\">belastingtarieven wijzigen</a> in de "
"WooCommerce-instellingen."

msgid "POS Barcode"
msgstr "POS-streepjescode"

msgid "Product barcode used at the point of sale"
msgstr "Productstreepjescode gebruikt bij het verkooppunt"

msgid "Something went wrong. Please try again later."
msgstr "Er is iets misgegaan. Probeer het later opnieuw."

