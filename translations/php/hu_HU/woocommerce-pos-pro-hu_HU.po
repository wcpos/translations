msgstr "Betöltés&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr ""
"Válassza ki azokat a felhasználókat, akik jogosultak hozzáférni ehhez az "
"üzlethez."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"Megjegyzés: csak a megfelelő jogosultságokkal rendelkező felhasználók "
"választhatók ki. <a href=\"%s\" target=\"_blank\">Részletekért lásd a "
"dokumentációt.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Webcím"

#. translators: wordpress
msgid "Email"
msgstr "E-mail"

msgid "Opening Hours notes"
msgstr "Nyitvatartási idő megjegyzések"

msgid "eg: Closed public holidays"
msgstr "pl.: Zárva ünnepnapokon"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Nyitvatartási időt adhat hozzá a weboldalához egy widget segítségével. <a "
"href=\"%s\">Olvassa el a dokumentációt</a> további információkért."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"Kérjük, <a href=\"%s\">olvassa el a dokumentációt</a> a POS nyugták "
"testreszabásáról."

msgid "Enable store price field"
msgstr "Üzlet ár mező engedélyezése"

msgid "Complimentary Close"
msgstr "Kiegészítő zárás"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr ""
"Személyes megjegyzések vagy szezonális üdvözletek, pl. Köszönjük a "
"rendelést! vagy Boldog Karácsonyt!"

msgid "Returns Policy"
msgstr "Visszaküldési szabályzat"

msgid "Returns policy, terms and conditions"
msgstr "Visszaküldési szabályzat, feltételek"

msgid "Footer"
msgstr "Lábléc"

msgid "Further footer information, e.g. copyright or branding"
msgstr "További lábléc információk, pl. szerzői jog vagy márkajelzés"

msgid "Calculate Tax Based On"
msgstr "Adó kiszámítása alapul"

msgid "this store address"
msgstr "ez az üzlet címe"

msgid "base location"
msgstr "alaphelyzet"

msgid "No tax rates set"
msgstr "Nincsenek adókulcsok beállítva"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"A fenti adókulcsok kerülnek alkalmazásra az értékesítési ponton. Az "
"adókulcsot <a href=\"%s\">megváltoztathatja</a> a WooCommerce "
"beállításokban."

msgid "POS Barcode"
msgstr "POS vonalkód"

msgid "Product barcode used at the point of sale"
msgstr "Termékvonalkód a pénztárnál"

msgid "Something went wrong. Please try again later."
msgstr "Valami hiba történt. Kérjük, próbálja meg később újra."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Bővítmény telepítés"

msgid "Your WCPOS Pro license is valid and active."
msgstr "A WCPOS Pro licenc érvényes és aktív."

msgid "You are receiving plugin updates."
msgstr "Kapja a bővítmény frissítéseket."

msgid "Your WCPOS Pro license is inactive."
msgstr "A WCPOS Pro licenc inaktív."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">Kattintson ide</a> a licenckulcs aktiválásához."

msgid "Your WCPOS Pro license has expired."
msgstr "A WCPOS Pro licenc lejárt."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Kérjük, újítsa meg</a> a frissítések fogadásához."

msgid "Your WCPOS Pro license is inactive"
msgstr "A WCPOS Pro licenc inaktív"

msgid "Your WCPOS Pro license has expired"
msgstr "A WCPOS Pro licenc lejárt"

msgid "Failed to save settings."
msgstr "A beállítások mentése nem sikerült."

