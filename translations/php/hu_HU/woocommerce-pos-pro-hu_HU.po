msgstr "Az üzlet nem található."

msgid "Failed to trash store."
msgstr "Nem sikerült az üzletet a kukába helyezni."

msgid "Failed to save settings."
msgstr "A beállítások mentése nem sikerült."

msgid "Add New Store"
msgstr "Új bolt hozzáadása"

msgid "New Store"
msgstr "Új bolt"

msgid "View Store"
msgstr "Bolt megtekintése"

msgid "Search Stores"
msgstr "Boltok keresése"

msgid "Parent Store:"
msgstr "Szülő bolt:"

