msgstr "A bővítmény telepítése sikertelen."

msgid "Plugin was installed but could not be located."
msgstr "A bővítmény telepítve lett, de nem található."

msgid "Extension is not installed."
msgstr "A kiterjesztés nincs telepítve."

msgid "Plugin update failed."
msgstr "A bővítmény frissítése sikertelen."

