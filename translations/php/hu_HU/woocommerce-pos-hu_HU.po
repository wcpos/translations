#, php-format
msgid "PHP syntax error: %s"
msgstr "PHP szintaxis hiba: %s"

msgid "PHP syntax error: Mismatched PHP tags."
msgstr "PHP szintaxis hiba: Nem egyező PHP címkék."

#. translators: %s: function name.
#, php-format
msgid ""
"Template contains dangerous function: %s(). This function is not allowed "
"for security reasons."
msgstr ""
"A sablon veszélyes függvényt tartalmaz: %s(). Ez a függvény biztonsági "
"okokból nem engedélyezett."

