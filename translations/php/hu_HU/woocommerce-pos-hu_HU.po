#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Értékesítési pont a WooCommerce-hez"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Egyszerű felület a WooCommerce rendelések kezelésére az értékesítési "
"ponton. Szükséges hozzá a <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> PHP %1$s vagy újabb verziót igényel. További "
"információ az <a href=\"%2$s\">frissítésről</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> a <a href=\"%1$s\">WooCommerce %2$s vagy újabb</a> "
"verziót igényli. Kérjük, <a href=\"%3$s\">telepítse és aktiválja a "
"WooCommerce-t</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"A <strong>WooCommerce REST API</strong> működéséhez <em>szép</em> állandó "
"hivatkozások szükségesek"

msgid "Enable permalinks"
msgstr "Állandó hivatkozások engedélyezése"

msgid "Cashier"
msgstr "Pénztáros"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> a <a href=\"%1$s\">WCPOS Pro %2$s vagy újabb</a> "
"verziót igényli. Kérjük, <a href=\"%3$s\">telepítse és aktiválja a WCPOS "
"Pro-t</a>"

