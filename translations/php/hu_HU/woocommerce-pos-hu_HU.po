msgid "You do not have permission to view this receipt."
msgstr "Nincs jogosultsága a nyugta megtekintéséhez."

msgid "Receipt Error"
msgstr "Nyugta hiba"

msgid "Receipt Template Error"
msgstr "Nyugta sablon hiba"

msgid ""
"There was a problem rendering the receipt template. This is usually caused "
"by a syntax error or undefined variable in the template code."
msgstr ""
"Probléma merült fel a nyugta sablon megjelenítése során. Ezt általában "
"szintaxis hiba vagy nem definiált változó okozza a sablon kódban."

msgid "File:"
msgstr "Fájl:"

msgid "Line:"
msgstr "Sor:"

msgid "Suggestions:"
msgstr "Javaslatok:"

msgid ""
"Check the template file for syntax errors (missing semicolons, brackets, "
"etc.)"
msgstr ""
"Ellenőrizze a sablon fájlt szintaxis hibákra (hiányzó pontosvesszők, "
"zárójelek stb.)."

msgid "Ensure all variables used in the template are defined"
msgstr "Győződjön meg róla, hogy a sablonban használt összes változó definiálva van"

msgid "Verify that any custom functions or classes exist"
msgstr "Ellenőrizze, hogy minden egyedi függvény vagy osztály létezik-e"

msgid "Try resetting to the default receipt template"
msgstr "Próbálja meg visszaállítani az alapértelmezett nyugta sablont"

msgid "Please contact the site administrator for assistance."
msgstr "Kérjük, lépjen kapcsolatba a webhely adminisztrátorával segítségért."

msgid "Invalid template language."
msgstr "Érvénytelen sablon nyelv."

#. translators: %s: pattern that was found.
