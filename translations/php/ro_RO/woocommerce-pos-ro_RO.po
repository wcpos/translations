msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> necesită <a href=\"%1$s\">WooCommerce %2$s sau mai mare</a>. Vă rugăm să <a href=\"%3$s\">instalați și activați WooCommerce</a>"

