msgstr "Vergi oranları ayarlanmadı"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Yukarıdaki vergi oranları satış noktasında kullanılacaktır. WooCommerce "
"ayarlarında <a href=\"%s\">vergi oranını değiştirebilirsiniz</a>."

msgid "POS Barcode"
msgstr "POS Barkod"

msgid "Product barcode used at the point of sale"
msgstr "Satış noktasında kullanılan ürün barkodu"

msgid "Something went wrong. Please try again later."
msgstr "Bir şeyler ters gitti. Lütfen daha sonra tekrar deneyin."

