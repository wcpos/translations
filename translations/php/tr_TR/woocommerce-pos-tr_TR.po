#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – WooCommerce için Satış Noktası"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Satış Noktasında WooCommerce siparişleri almak için basit bir ön yüz. <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a> "
"gerektirir."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> PHP %1$s veya daha üstünü gerektirir. <a "
"href=\"%2$s\">nasıl güncelleyebileceğiniz</a> hakkında daha fazla bilgi "
"edinin"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> <a href=\"%1$s\">WooCommerce %2$s veya üstünü</a> "
"gerektirir. Lütfen <a href=\"%3$s\">WooCommerce'i yükleyin ve "
"etkinleştirin</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> düzgün çalışması için <em>güzel</em> "
"kalıcı bağlantılar gerektirir"

msgid "Enable permalinks"
msgstr "Kalıcı bağlantıları etkinleştir"

msgid "Cashier"
msgstr "Kasiyer"

