#. translators: Short WCPOS UI label; keep concise.
#: includes/Templates/Payment.php:259
msgid "Checkout Settings"
msgstr "Настройки за плащане"

#: includes/Templates/Payment.php:265
msgid ""
"Scripts and styles may interfere with the custom payment template, use this form to dequeue any problematic scripts."
msgstr ""
