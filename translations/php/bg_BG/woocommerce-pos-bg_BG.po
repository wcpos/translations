"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> изисква <em>красиви</em> пермалинкове за правилна работа"

msgid "Enable permalinks"
msgstr "Активирайте пермалинкове"

msgid "Cashier"
msgstr "Касиер"

