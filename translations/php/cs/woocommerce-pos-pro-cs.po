#. translators: wordpress
msgid "Loading&#8230;"
msgstr "Načítání&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "Vyberte uživatele, kteří mají oprávnění přistupovat k tomuto obchodu."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"Poznámka: K výběru budou k dispozici pouze uživatelé s odpovídajícími oprávněními. <a href=\"%s\" target=\"_blank\">Podívejte se na dokumentaci pro podrobnosti.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "Webová adresa"

#. translators: wordpress
msgid "Email"
msgstr "Email"

msgid "Opening Hours notes"
msgstr "Poznámky k otevírací době"

msgid "eg: Closed public holidays"
msgstr "např.: Zavřeno o státních svátcích"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Můžete přidat otevírací dobu na svůj web pomocí widgetu. <a href=\"%s\">Přečtěte si dokumentaci</a> pro více informací."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"Prosím <a href=\"%s\">přečtěte si dokumentaci</a> pro informace o tom, jak přizpůsobit své účtenky POS."

msgid "Enable store price field"
msgstr "Povolit pole ceny obchodu"

msgid "Complimentary Close"
msgstr "Doplněk na závěr"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"Osobní poznámky nebo sezónní přání, např. Děkujeme za vaši objednávku! nebo Veselé Vánoce!"

msgid "Returns Policy"
msgstr "Pravidla pro vrácení"

msgid "Returns policy, terms and conditions"
msgstr "Pravidla pro vrácení, podmínky"

msgid "Footer"
msgstr "Patička"

msgid "Further footer information, e.g. copyright or branding"
msgstr "Další informace v patičce, např. autorská práva nebo značka"

msgid "Calculate Tax Based On"
msgstr "Vypočítat daň na základě"

msgid "this store address"
msgstr "tato adresa obchodu"

msgid "base location"
msgstr "základní umístění"

msgid "No tax rates set"
msgstr "Žádné daňové sazby nejsou nastaveny"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"Výše uvedené daňové sazby budou použity v místě prodeje. Můžete <a href=\"%s\">změnit daňovou sazbu</a> v nastavení WooCommerce."

msgid "POS Barcode"
msgstr "POS čárový kód"

msgid "Product barcode used at the point of sale"
msgstr "Čárový kód produktu používaný na místě prodeje"

msgid "Something went wrong. Please try again later."
msgstr "Něco se pokazilo. Zkuste to prosím později."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "Instalace pluginu"

msgid "Your WCPOS Pro license is valid and active."
msgstr "Vaše licence WCPOS Pro je platná a aktivní."

msgid "You are receiving plugin updates."
msgstr "Dostáváte aktualizace pluginu."

msgid "Your WCPOS Pro license is inactive."
msgstr "Vaše licence WCPOS Pro je neaktivní."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">Klikněte zde</a> pro aktivaci vašeho licenčního klíče."

msgid "Your WCPOS Pro license has expired."
msgstr "Vaše licence WCPOS Pro vypršela."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">Obnovte prosím</a> pro získání aktualizací."

msgid "Your WCPOS Pro license is inactive"
msgstr "Vaše licence WCPOS Pro je neaktivní"

msgid "Your WCPOS Pro license has expired"
msgstr "Vaše licence WCPOS Pro vypršela"

msgid "You do not have permission to manage plugins."
msgstr "Nemáte oprávnění spravovat pluginy."

#. translators: %s: extension slug
#, php-format
msgid "Extension \"%s\" not found in catalog."
msgstr "Rozšíření \"%s\" nebylo nalezeno v katalogu."

msgid "Invalid action."
msgstr "Neplatná akce."

msgid "No download URL available for this extension."
msgstr "Pro toto rozšíření není k dispozici žádná URL ke stažení."

msgid "Plugin installation failed."
msgstr "Instalace pluginu selhala."

msgid "Plugin was installed but could not be located."
msgstr "Plugin byl nainstalován, ale nelze jej nalézt."

msgid "Extension is not installed."
msgstr "Rozšíření není nainstalováno."

msgid "Plugin update failed."
msgstr "Aktualizace pluginu selhala."

msgid "You do not have permission to manage stores."
msgstr "Nemáte oprávnění spravovat obchody."

msgid "Store not found."
msgstr "Obchod nenalezen."

msgid "Failed to trash store."
msgstr "Nepodařilo se přesunout obchod do koše."

msgid "Failed to save settings."
msgstr "Nepodařilo se uložit nastavení."

msgid "Add New Store"
msgstr "Přidat nový obchod"

msgid "New Store"
msgstr "Nový obchod"

msgid "View Store"
msgstr "Zobrazit obchod"

msgid "Search Stores"
msgstr "Hledat obchody"

msgid "Parent Store:"
msgstr "Nadřazený obchod:"

msgid "No Stores found."
msgstr "Žádné obchody nebyly nalezeny."

msgid "No Stores found in Trash."
msgstr "V koši nebyly nalezeny žádné obchody."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "Nepodařilo se načíst WCPOS Pro. Spusťte prosím composer install."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin has been automatically deactivated. You may safely delete it from your plugins."
msgstr ""
"nyní obsahuje všechny funkce z bezplatného pluginu. Samostatný bezplatný plugin byl automaticky deaktivován. Můžete jej bezpečně odstranit ze svých pluginů."
