#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – Pokladní systém pro WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"Kompletní pokladní řešení pro WooCommerce. Pro verze zahrnuje všechny funkce z bezplatného pluginu plus podporu více obchodů, vlastní účtenky a další."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "Obchody"

msgid "Cashiers"
msgstr "Pokladní"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS Pro je nyní samostatný."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"Pro plugin zahrnuje všechny funkce z bezplatné verze. Můžete bezpečně deaktivovat a odstranit tento plugin."

msgid "Edit Store"
msgstr "Upravit obchod"

msgid "All"
msgstr "Všichni"

msgid "Open POS"
msgstr "Otevřít POS"

msgid "Store"
msgstr "Obchod"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "Autorizovaní uživatelé"

msgid "Opening Hours"
msgstr "Otevírací doba"

msgid "Logo"
msgstr "Logo"

#. translators: wordpress.
msgid "Contact Info"
msgstr "Kontaktní informace"

msgid "Receipt Options"
msgstr "Možnosti účtenky"

msgid "Set featured image"
msgstr "Nastavit hlavní obrázek"

msgid "Set store logo"
msgstr "Nastavit logo obchodu"

msgid "Remove featured image"
msgstr "Odebrat hlavní obrázek"

msgid "Remove store logo"
msgstr "Odebrat logo obchodu"

msgid "Set Store Logo"
msgstr "Nastavit logo obchodu"

#. translators: wordpress.
msgid "Monday"
msgstr "Pondělí"

#. translators: wordpress.
msgid "Tuesday"
msgstr "Úterý"

#. translators: wordpress.
msgid "Wednesday"
msgstr "Středa"

#. translators: wordpress.
msgid "Thursday"
msgstr "Čtvrtek"

#. translators: wordpress.
