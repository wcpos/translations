msgid "Select the users who are authorized to access this store."
msgstr "Vyberte uživatele, kteří mají oprávnění přistupovat k tomuto obchodu."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"Poznámka: pouze uživatelé s příslušnými oprávněními budou k dispozici pro "
"výběr. <a href=\"%s\" target=\"_blank\">Podívejte se na dokumentaci pro "
"podrobnosti.</a>"

