#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – Titik Jualan untuk WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"Antara muka mudah untuk mengambil pesanan WooCommerce di Titik Jualan. "
"Memerlukan <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> memerlukan PHP %1$s atau lebih tinggi. Baca lebih "
"lanjut tentang <a href=\"%2$s\">cara anda boleh mengemas kini</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> memerlukan <a href=\"%1$s\">WooCommerce %2$s atau "
"lebih tinggi</a>. Sila <a href=\"%3$s\">pasang dan aktifkan WooCommerce</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> memerlukan pautan kekal "
"<em>cantik</em> untuk berfungsi dengan betul"

msgid "Enable permalinks"
msgstr "Aktifkan pautan kekal"

msgid "Cashier"
msgstr "Juruwang"

