msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> kräver <a href=\"%1$s\">WooCommerce %2$s eller högre</a>. Vänligen <a href=\"%3$s\">installera och aktivera WooCommerce</a>"

