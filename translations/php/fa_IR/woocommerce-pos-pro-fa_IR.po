#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – نقطه فروش برای ووکامرس"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"یک راه‌حل کامل نقطه فروش برای ووکامرس. نسخه Pro شامل تمام ویژگی‌های افزونه رایگان به‌علاوه پشتیبانی از چند فروشگاه، رسیدهای سفارشی و بیشتر است."

#. Author of the plugin
msgid "kilbot"
msgstr "کیل‌بات"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "فروشگاه‌ها"

msgid "Cashiers"
msgstr "صندوقداران"

msgid "Gateways"
msgstr "Gatewayها"

msgid "WooCommerce POS Pro is now standalone."
msgstr "ووکامرس POS Pro اکنون مستقل است."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"افزونه Pro شامل تمام ویژگی‌های نسخه رایگان است. می‌توانید با اطمینان این افزونه را غیرفعال و حذف کنید."

msgid "Edit Store"
msgstr "ویرایش فروشگاه"

msgctxt "All authorized users"
msgid "All"
msgstr "تمام"

msgid "Open POS"
msgstr "باز کردن POS"

msgid "Store"
msgstr "فروشگاه"

#. translators: woocommerce.
msgid "Authorized Users"
msgstr "کاربران مجاز"

msgid "Opening Hours"
msgstr "ساعات کاری"

msgid "Logo"
msgstr "لوگو"

#. translators: wordpress.
msgid "Contact Info"
msgstr "اطلاعات تماس"

msgid "Receipt Options"
msgstr "گزینه‌های رسید"

msgid "Set featured image"
msgstr "تنظیم تصویر ویژه"

msgid "Set store logo"
msgstr "تنظیم لوگوی فروشگاه"

msgid "Remove featured image"
msgstr "حذف تصویر ویژه"

msgid "Remove store logo"
msgstr "حذف لوگوی فروشگاه"

msgid "Set Store Logo"
msgstr "تنظیم لوگوی فروشگاه"

#. translators: wordpress.
msgid "Monday"
msgstr "دوشنبه"

#. translators: wordpress.
msgid "Tuesday"
msgstr "سه‌شنبه"

#. translators: wordpress.
msgid "Wednesday"
msgstr "چهارشنبه"

#. translators: wordpress.
msgid "Thursday"
msgstr "پنج‌شنبه"

#. translators: wordpress.
msgid "Friday"
msgstr "جمعه"

#. translators: wordpress.
msgid "Saturday"
msgstr "شنبه"

#. translators: wordpress.
msgid "Sunday"
msgstr "یکشنبه"

#. translators: wordpress
msgid "Loading&#8230;"
msgstr "در حال بارگذاری&#8230;"

msgid "Select the users who are authorized to access this store."
msgstr "کاربرانی را که مجاز به دسترسی به این فروشگاه هستند انتخاب کنید."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"توجه: فقط کاربرانی که دارای مجوزهای مناسب هستند برای انتخاب در دسترس خواهند بود. <a href=\"%s\" target=\"_blank\">برای جزئیات به مستندات مراجعه کنید.</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "آدرس وب"

#. translators: wordpress
msgid "Email"
msgstr "ایمیل"

msgid "Opening Hours notes"
msgstr "یادداشت‌های ساعات کاری"

msgid "eg: Closed public holidays"
msgstr "مثال: تعطیلات عمومی بسته است"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"می‌توانید ساعات کاری را با استفاده از یک ویجت به وب‌سایت خود اضافه کنید. <a href=\"%s\">مستندات را بخوانید</a> برای اطلاعات بیشتر."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"لطفاً <a href=\"%s\">مستندات را بخوانید</a> برای اطلاعات در مورد نحوه سفارشی‌سازی رسیدهای POS خود."

msgid "Enable store price field"
msgstr "فعال‌سازی فیلد قیمت فروشگاه"

msgid "Complimentary Close"
msgstr "پایان تکمیلی"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"یادداشت‌های شخصی یا تبریک‌های فصلی، مانند: از سفارش شما متشکریم! یا کریسمس مبارک!"

msgid "Returns Policy"
msgstr "سیاست بازگشت"

msgid "Returns policy, terms and conditions"
msgstr "سیاست بازگشت، شرایط و ضوابط"

msgid "Footer"
msgstr "پاورقی"

msgid "Further footer information, e.g. copyright or branding"
msgstr "اطلاعات بیشتر پاورقی، مانند حق‌تکثیر یا برندینگ"

msgid "Calculate Tax Based On"
msgstr "محاسبه مالیات بر اساس"

msgid "this store address"
msgstr "آدرس این فروشگاه"

msgid "base location"
msgstr "موقعیت پایه"

msgid "No tax rates set"
msgstr "نرخ‌های مالیاتی تنظیم نشده‌اند"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"نرخ‌های مالیاتی بالا در نقطه فروش استفاده خواهند شد. می‌توانید <a href=\"%s\">نرخ مالیات را تغییر دهید</a> در تنظیمات ووکامرس."

msgid "POS Barcode"
msgstr "بارکد POS"

msgid "Product barcode used at the point of sale"
msgstr "بارکد محصول استفاده شده در نقطه فروش"

msgid "Something went wrong. Please try again later."
msgstr "مشکلی پیش آمد. لطفاً بعداً دوباره تلاش کنید."

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "نصب افزونه"

msgid "Your WCPOS Pro license is valid and active."
msgstr "لایسنس WCPOS Pro شما معتبر و فعال است."

msgid "You are receiving plugin updates."
msgstr "شما به‌روزرسانی‌های افزونه را دریافت می‌کنید."

msgid "Your WCPOS Pro license is inactive."
msgstr "لایسنس WCPOS Pro شما غیرفعال است."

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">اینجا کلیک کنید</a> تا کلید لایسنس خود را فعال کنید."

msgid "Your WCPOS Pro license has expired."
msgstr "لایسنس WCPOS Pro شما منقضی شده است."

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">لطفاً تمدید کنید</a> تا به‌روزرسانی‌ها را دریافت کنید."

msgid "Your WCPOS Pro license is inactive"
msgstr "لایسنس WCPOS Pro شما غیرفعال است"

msgid "Your WCPOS Pro license has expired"
msgstr "لایسنس WCPOS Pro شما منقضی شده است"

msgid "You do not have permission to manage plugins."
msgstr "شما اجازه مدیریت افزونه‌ها را ندارید."

#. translators: %s: extension slug
#, php-format
msgid "Extension \"%s\" not found in catalog."
msgstr "افزونه \"%s\" در کاتالوگ یافت نشد."

msgid "Invalid action."
msgstr "عمل نامعتبر است."

msgid "No download URL available for this extension."
msgstr "هیچ آدرس دانلودی برای این افزونه موجود نیست."

msgid "Plugin installation failed."
msgstr "نصب افزونه ناموفق بود."

msgid "Plugin was installed but could not be located."
msgstr "افزونه نصب شد اما قابل یافتن نیست."

msgid "Extension is not installed."
msgstr "افزونه نصب نشده است."

msgid "Plugin update failed."
msgstr "به‌روزرسانی افزونه ناموفق بود."

msgid "You do not have permission to manage stores."
msgstr "شما اجازه مدیریت فروشگاه‌ها را ندارید."

msgid "Store not found."
msgstr "فروشگاه پیدا نشد."

msgid "Failed to trash store."
msgstr "حذف فروشگاه ناموفق بود."

msgid "Failed to save settings."
msgstr "ذخیره تنظیمات ناموفق بود."

msgid "Add New Store"
msgstr "افزودن فروشگاه جدید"

msgid "New Store"
msgstr "فروشگاه جدید"

msgid "View Store"
msgstr "مشاهده فروشگاه"

msgid "Search Stores"
msgstr "جستجوی فروشگاه‌ها"

msgid "Parent Store:"
msgstr "فروشگاه والد:"

msgid "No Stores found."
msgstr "هیچ فروشگاهی یافت نشد."

msgid "No Stores found in Trash."
msgstr "هیچ فروشگاهی در زباله‌دان یافت نشد."

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "بارگذاری WCPOS Pro ناموفق بود. لطفاً composer install را اجرا کنید."

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin has been automatically deactivated. You may safely delete it from your plugins."
msgstr ""
"اکنون شامل تمام ویژگی‌های افزونه رایگان است. افزونه رایگان مستقل به‌طور خودکار غیرفعال شده است. می‌توانید آن را با اطمینان از افزونه‌های خود حذف کنید."
