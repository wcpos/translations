#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS - نقطه فروش برای WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. "
"Requires <a "
"href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"یک رابط کاربری ساده برای گرفتن سفارش‌های WooCommerce در نقطه فروش. نیازمند "
"<a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a> است."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information "
"about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> نیازمند PHP %1$s یا بالاتر است. اطلاعات بیشتر درباره "
"<a href=\"%2$s\">چگونگی به‌روزرسانی</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> نیازمند <a href=\"%1$s\">WooCommerce %2$s یا "
"بالاتر</a> است. لطفاً <a href=\"%3$s\">WooCommerce را نصب و فعال کنید</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks "
"to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> نیازمند پیوندهای دائمی <em>زیبا</em> "
"برای عملکرد صحیح است"

msgid "Enable permalinks"
msgstr "فعال‌سازی پیوندهای دائمی"

msgid "Cashier"
msgstr "صندوقدار"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or "
"higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> نیازمند <a href=\"%1$s\">WCPOS Pro %2$s یا "
"بالاتر</a> است. لطفاً <a href=\"%3$s\">WCPOS Pro را نصب و فعال کنید</a>"

