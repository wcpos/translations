#. Plugin Name of the plugin
msgid "WCPOS Pro – Point of Sale for WooCommerce"
msgstr "WCPOS Pro – Punto de Venta para WooCommerce"

#. Plugin URI of the plugin
msgid "https://wcpos.com/pro"
msgstr "https://wcpos.com/pro"

#. Description of the plugin
msgid ""
"A complete Point of Sale solution for WooCommerce. Pro includes all features from the free plugin plus multi-store support, custom receipts, and more."
msgstr ""
"Una solución completa de Punto de Venta para WooCommerce. Pro incluye todas las funciones del plugin gratuito más soporte para múltiples tiendas, recibos personalizados y más."

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://www.kilbot.com"
msgstr "http://www.kilbot.com"

msgid "Stores"
msgstr "Tiendas"

msgid "Cashiers"
msgstr "Cajeros"

msgid "Gateways"
msgstr "Gateways"

msgid "WooCommerce POS Pro is now standalone."
msgstr "WooCommerce POS Pro ahora es independiente."

msgid ""
"The Pro plugin includes all features from the free version. You can safely deactivate and delete this plugin."
msgstr ""
"El plugin Pro incluye todas las funciones de la versión gratuita. Puede desactivar y eliminar este plugin de forma segura."

