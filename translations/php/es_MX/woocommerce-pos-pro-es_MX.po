#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for selection. <a href=\"%s\" target=\"_blank\">See the documentation for details.</a>"
msgstr ""
"Nota: solo los usuarios con los privilegios adecuados estarán disponibles para selección. <a href=\"%s\" target=\"_blank\">Consulte la documentación para más detalles.</a>"

