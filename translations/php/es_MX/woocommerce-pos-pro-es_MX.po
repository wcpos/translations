msgstr "ej: Cerrado días festivos"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a href=\"%s\">Read the docs</a> for more information."
msgstr ""
"Puede agregar el horario de apertura a su sitio web usando un widget. <a href=\"%s\">Lea la documentación</a> para más información."

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize your POS receipts."
msgstr ""
"Por favor, <a href=\"%s\">lea la documentación</a> para obtener información sobre cómo personalizar sus recibos POS."

msgid "Enable store price field"
msgstr "Habilitar campo de precio de tienda"

msgid "Complimentary Close"
msgstr "Cierre Complementario"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry Christmas!"
msgstr ""
"Notas personales o saludos de temporada, ej. ¡Gracias por su pedido! o ¡Feliz Navidad!"

msgid "Returns Policy"
msgstr "Política de Devoluciones"

msgid "Returns policy, terms and conditions"
msgstr "Política de devoluciones, términos y condiciones"

