msgid "Select the users who are authorized to access this store."
msgstr "ជ្រើសរើសអ្នកប្រើដែលបានអនុញ្ញាតឱ្យចូលដំណើរការហាងនេះ។"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Note: only the users with the proper privileges will be available for "
"selection. <a href=\"%s\" target=\"_blank\">See the documentation for "
"details.</a>"
msgstr ""
"សម្គាល់៖ មានតែអ្នកប្រើដែលមានសិទ្ធិត្រឹមត្រូវប៉ុណ្ណោះដែលអាចជ្រើសរើសបាន។ <a "
"href=\"%s\" target=\"_blank\">មើលឯកសារសម្រាប់ព័ត៌មានលម្អិត។</a>"

#. translators: wordpress
msgid "Web Address"
msgstr "អាសយដ្ឋានបណ្តាញ"

#. translators: wordpress
msgid "Email"
msgstr "អ៊ីមែល"

msgid "Opening Hours notes"
msgstr "កំណត់ចំណាំម៉ោងបើក"

msgid "eg: Closed public holidays"
msgstr "ឧទាហរណ៍៖ បិទថ្ងៃឈប់សម្រាកសាធារណៈ"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"You can add opening hours to your website using a widget. <a "
"href=\"%s\">Read the docs</a> for more information."
msgstr ""
"អ្នកអាចបន្ថែមម៉ោងបើកទៅគេហទំព័ររបស់អ្នកដោយប្រើ widget។ <a "
"href=\"%s\">អានឯកសារ</a> សម្រាប់ព័ត៌មានបន្ថែម។"

#. translators: %s: documentation URL.
#, php-format
msgid ""
"Please <a href=\"%s\">read the docs</a> for information on how to customize "
"your POS receipts."
msgstr ""
"សូម<a href=\"%s\">អានឯកសារ</a>សម្រាប់ព័ត៌មានអំពីរបៀបប្តូរតាមបំណងវិក័យប័ត្រ "
"POS របស់អ្នក។"

msgid "Enable store price field"
msgstr "បើកវាលតម្លៃហាង"

msgid "Complimentary Close"
msgstr "បិទដោយឥតគិតថ្លៃ"

msgid ""
"Personal notes or season greetings, e.g. Thank You for Your Order! or Merry "
"Christmas!"
msgstr ""
"កំណត់ចំណាំផ្ទាល់ខ្លួន ឬការគួរសមរដូវកាល ឧទាហរណ៍ "
"សូមអរគុណសម្រាប់ការបញ្ជាទិញរបស់អ្នក! ឬ សួស្តីបុណ្យណូអែល!"

msgid "Returns Policy"
msgstr "គោលការណ៍ត្រឡប់"

msgid "Returns policy, terms and conditions"
msgstr "គោលការណ៍ត្រឡប់ លក្ខខណ្ឌ និងលក្ខខណ្ឌ"

msgid "Footer"
msgstr "បាតកថា"

msgid "Further footer information, e.g. copyright or branding"
msgstr "ព័ត៌មានបាតកថាបន្ថែម ឧទាហរណ៍ សិទ្ធិច្បាប់ ឬម៉ាក"

msgid "Calculate Tax Based On"
msgstr "គណនាពន្ធដោយផ្អែកលើ"

msgid "this store address"
msgstr "អាសយដ្ឋានហាងនេះ"

msgid "base location"
msgstr "ទីតាំងមូលដ្ឋាន"

msgid "No tax rates set"
msgstr "មិនមានអត្រាពន្ធដែលបានកំណត់"

#. translators: %s: WooCommerce tax settings URL.
#, php-format
msgid ""
"The tax rates above will be used at the point of sale. You can <a "
"href=\"%s\">change the tax rate</a> in WooCommerce settings."
msgstr ""
"អត្រាពន្ធខាងលើនឹងត្រូវបានប្រើនៅចំណុចលក់។ អ្នកអាច<a "
"href=\"%s\">ផ្លាស់ប្តូរអត្រាពន្ធ</a>នៅក្នុងការកំណត់ WooCommerce។"

msgid "POS Barcode"
msgstr "បាកូដ POS"

msgid "Product barcode used at the point of sale"
msgstr "បាកូដផលិតផលប្រើនៅចំណុចលក់"

msgid "Something went wrong. Please try again later."
msgstr "មានអ្វីមួយខុស។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។"

#. translators: WordPress.
msgid "Plugin Installation"
msgstr "ការដំឡើងផ្លក់អ៊ីន"

msgid "Your WCPOS Pro license is valid and active."
msgstr "អាជ្ញាប័ណ្ណ WCPOS Pro របស់អ្នកមានសុពលភាព និងសកម្ម។"

msgid "You are receiving plugin updates."
msgstr "អ្នកកំពុងទទួលបានការធ្វើបច្ចុប្បន្នភាពផ្លក់អ៊ីន។"

msgid "Your WCPOS Pro license is inactive."
msgstr "អាជ្ញាប័ណ្ណ WCPOS Pro របស់អ្នកមិនសកម្ម។"

#. translators: %s: URL to settings page.
#, php-format
msgid "<a href=\"%s\">Click here</a> to activate your license key."
msgstr "<a href=\"%s\">ចុចទីនេះ</a> ដើម្បីធ្វើឱ្យសកម្មកូនសោអាជ្ញាប័ណ្ណរបស់អ្នក។"

msgid "Your WCPOS Pro license has expired."
msgstr "អាជ្ញាប័ណ្ណ WCPOS Pro របស់អ្នកបានផុតកំណត់។"

#. translators: %s: URL to account page.
#, php-format
msgid "<a href=\"%s\">Please renew</a> to receive updates."
msgstr "<a href=\"%s\">សូមធ្វើឱ្យថ្មី</a> ដើម្បីទទួលបានការធ្វើបច្ចុប្បន្នភាព។"

msgid "Your WCPOS Pro license is inactive"
msgstr "អាជ្ញាប័ណ្ណ WCPOS Pro របស់អ្នកមិនសកម្ម"

msgid "Your WCPOS Pro license has expired"
msgstr "អាជ្ញាប័ណ្ណ WCPOS Pro របស់អ្នកបានផុតកំណត់"

msgid "You do not have permission to manage plugins."
msgstr "អ្នកមិនមានសិទ្ធិគ្រប់គ្រងផ្លក់អ៊ីនទេ។"

#. translators: %s: extension slug
#, php-format
msgid "Extension \"%s\" not found in catalog."
msgstr "ផ្នែកបន្ថែម \"%s\" មិនបានរកឃើញនៅក្នុងបញ្ជីទេ។"

msgid "Invalid action."
msgstr "សកម្មភាពមិនត្រឹមត្រូវ។"

msgid "No download URL available for this extension."
msgstr "គ្មាន URL ទាញយកសម្រាប់ផ្នែកបន្ថែមនេះទេ។"

msgid "Plugin installation failed."
msgstr "ការដំឡើងផ្លក់អ៊ីនបានបរាជ័យ។"

msgid "Plugin was installed but could not be located."
msgstr "ផ្លក់អ៊ីនត្រូវបានដំឡើងប៉ុន្តែមិនអាចរកឃើញបាន។"

msgid "Extension is not installed."
msgstr "ផ្នែកបន្ថែមមិនត្រូវបានដំឡើង។"

msgid "Plugin update failed."
msgstr "ការធ្វើបច្ចុប្បន្នភាពផ្លក់អ៊ីនបានបរាជ័យ។"

msgid "Failed to save settings."
msgstr "ការរក្សាទុកការកំណត់បានបរាជ័យ។"

msgid "Add New Store"
msgstr "បន្ថែមហាងថ្មី"

msgid "New Store"
msgstr "ហាងថ្មី"

msgid "Edit Store"
msgstr "កែសម្រួលហាង"

msgid "View Store"
msgstr "មើលហាង"

msgid "Search Stores"
msgstr "ស្វែងរកហាង"

msgid "Parent Store:"
msgstr "ហាងមេ:"

msgid "No Stores found."
msgstr "រកមិនឃើញហាង។"

msgid "No Stores found in Trash."
msgstr "រកមិនឃើញហាងនៅក្នុងធុងសំរាម។"

msgid "WCPOS Pro failed to load. Please run composer install."
msgstr "WCPOS Pro បានបរាជ័យក្នុងការផ្ទុក។ សូមដំណើរការ composer install។"

msgid "WCPOS Pro"
msgstr "WCPOS Pro"

msgid ""
"now includes all features from the free plugin. The standalone free plugin "
"has been automatically deactivated. You may safely delete it from your "
"plugins."
msgstr ""
"ឥឡូវនេះរួមបញ្ចូលគ្រប់លក្ខណៈពិសេសពីផ្លក់អ៊ីនឥតគិតថ្លៃ។ "
"ផ្លក់អ៊ីនឥតគិតថ្លៃដែលឈរតែម្នាក់ឯងត្រូវបានបិទដោយស្វ័យប្រវត្តិ។ "
"អ្នកអាចលុបវាចេញពីផ្លក់អ៊ីនរបស់អ្នកបានដោយសុវត្ថិភាព។"

msgctxt "All authorized users"
msgid "All"
msgstr "ទាំងអស់"