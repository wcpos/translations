#: includes/Activator.php:1071
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> ត្រូវការកំណែ <a href=\"%1$s\">WooCommerce %2$s ឬខ្ពស់ជាងនេះ</a>។ សូម<a href=\"%3$s\">ដំឡើង និងធ្វើឱ្យ WooCommerce សកម្ម</a>"

