msgid "Sorry, this order is invalid."
msgstr "សូមទោស, ការបញ្ជាទិញនេះមិនត្រឹមត្រូវ។"

msgid "You do not have permission to view this receipt."
msgstr "អ្នកមិនមានសិទ្ធិមើលបង្កាន់ដៃនេះទេ។"

msgid "Receipt Error"
msgstr "កំហុសបង្កាន់ដៃ"

msgid "Receipt Template Error"
msgstr "កំហុសពុម្ពបង្កាន់ដៃ"

msgid ""
"There was a problem rendering the receipt template. This is usually caused "
"by a syntax error or undefined variable in the template code."
msgstr ""
"មានបញ្ហាក្នុងការបង្ហាញពុម្ពបង្កាន់ដៃ។ "
"នេះជាធម្មតាបណ្តាលមកពីកំហុសវាក្យសម្ពន្ធ ឬអថេរមិនបានកំណត់ក្នុងកូដពុម្ព។"

msgid "File:"
msgstr "ឯកសារ:"

msgid "Line:"
msgstr "បន្ទាត់:"

msgid "Suggestions:"
msgstr "សំណើ:"

msgid ""
"Check the template file for syntax errors (missing semicolons, brackets, "
"etc.)"
msgstr "ពិនិត្យឯកសារពុម្ពសម្រាប់កំហុសវាក្យសម្ពន្ធ (ខ្វះសញ្ញាសម្រួល, សញ្ញាក្រចក, ល។)"

msgid "Ensure all variables used in the template are defined"
msgstr "ធានាថាអថេរទាំងអស់ដែលប្រើនៅក្នុងពុម្ពត្រូវបានកំណត់"

msgid "Verify that any custom functions or classes exist"
msgstr "ផ្ទៀងផ្ទាត់ថាមុខងារផ្ទាល់ខ្លួន ឬថ្នាក់ណាមួយមាន"

msgid "Try resetting to the default receipt template"
msgstr "សូមព្យាយាមកំណត់ឡើងវិញទៅពុម្ពបង្កាន់ដៃលំនាំដើម"

msgid "Please contact the site administrator for assistance."
msgstr "សូមទាក់ទងអ្នកគ្រប់គ្រងតំបន់បណ្តាញសម្រាប់ជំនួយ។"

msgid "Invalid template language."
msgstr "ភាសាពុម្ពមិនត្រឹមត្រូវ។"

#. translators: %s: pattern that was found.
#, php-format
msgid "Template contains potentially dangerous JavaScript code: %s"
msgstr "ពុម្ពមានកូដ JavaScript ដែលអាចមានគ្រោះថ្នាក់: %s"

#. translators: %s: error message.
#, php-format
msgid "PHP syntax error: %s"
msgstr "កំហុសវាក្យសម្ពន្ធ PHP: %s"

msgid "PHP syntax error: Mismatched PHP tags."
msgstr "កំហុសវាក្យសម្ពន្ធ PHP: ស្លាក PHP មិនត្រូវគ្នា។"

#. translators: %s: function name.
#, php-format
msgid ""
"Template contains dangerous function: %s(). This function is not allowed "
"for security reasons."
msgstr ""
"ពុម្ពមានមុខងារគ្រោះថ្នាក់: %s()។ "
"មុខងារនេះមិនត្រូវបានអនុញ្ញាតដោយសារតែហេតុផលសុវត្ថិភាព។"

msgid "Point of Sale"
msgstr "ចំណុចលក់"

msgid "Tax Receipt"
msgstr "បង្កាន់ដៃពន្ធ"

msgid "The WCPOS plugin failed to load correctly."
msgstr "កម្មវិធីជំនួយ WCPOS បានបរាជ័យក្នុងការផ្ទុកត្រឹមត្រូវ។"

msgctxt "Permalink setting, eg: /pos"
msgid "POS base"
msgstr "មូលដ្ឋាន POS"

msgctxt "Money returned from cash sale"
msgid "Change"
msgstr "ប្រាក់អាប់"

msgctxt "Order status"
msgid "POS - Open"
msgstr "POS - បើក"

msgctxt "Order status"
msgid "POS - Partial Payment"
msgstr "POS - ការបង់ប្រាក់ផ្នែក"

msgctxt "Post Type General Name"
msgid "Templates"
msgstr "ពុម្ព"

msgctxt "Post Type Singular Name"
msgid "Template"
msgstr "ពុម្ព"

