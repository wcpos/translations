#. Plugin Name of the plugin
msgid "WCPOS – Point of Sale for WooCommerce"
msgstr "WCPOS – ចំណុចលក់សម្រាប់ WooCommerce"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/woocommerce-pos/"
msgstr "https://wordpress.org/plugins/woocommerce-pos/"

#. Description of the plugin
msgid ""
"A simple front-end for taking WooCommerce orders at the Point of Sale. Requires <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>."
msgstr ""
"មុខងារខាងមុខសាមញ្ញសម្រាប់ទទួលការបញ្ជាទិញ WooCommerce នៅចំណុចលក់។ ត្រូវការការដំឡើង <a href=\"http://wordpress.org/plugins/woocommerce/\">WooCommerce</a>។"

#. Author of the plugin
msgid "kilbot"
msgstr "kilbot"

#. Author URI of the plugin
msgid "http://wcpos.com"
msgstr "http://wcpos.com"

#. translators: 1: Minimum PHP version, 2: Update URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires PHP %1$s or higher. Read more information about <a href=\"%2$s\">how you can update</a>"
msgstr ""
"<strong>WCPOS</strong> ត្រូវការកំណែ PHP %1$s ឬខ្ពស់ជាងនេះ។ អានព័ត៌មានបន្ថែមអំពី <a href=\"%2$s\">វិធីធ្វើបច្ចុប្បន្នភាព</a>"

#. translators: 1: WooCommerce URL, 2: Minimum WC version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WooCommerce %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WooCommerce</a>"
msgstr ""
"<strong>WCPOS</strong> ត្រូវការកំណែ <a href=\"%1$s\">WooCommerce %2$s ឬខ្ពស់ជាងនេះ</a>។ សូម<a href=\"%3$s\">ដំឡើង និងធ្វើឱ្យ WooCommerce សកម្ម</a>"

msgid ""
"<strong>WooCommerce REST API</strong> requires <em>pretty</em> permalinks to work correctly"
msgstr ""
"<strong>WooCommerce REST API</strong> ត្រូវការប្រភេទ permalink <em>ស្អាត</em> ដើម្បីធ្វើការបានត្រឹមត្រូវ"

msgid "Enable permalinks"
msgstr "បើកការប្រើប្រាស់ permalinks"

msgid "Cashier"
msgstr "អ្នកគិតលុយ"

#. translators: 1: WCPOS Pro URL, 2: Minimum Pro version, 3: Plugins URL.
#, php-format
msgid ""
"<strong>WCPOS</strong> requires <a href=\"%1$s\">WCPOS Pro %2$s or higher</a>. Please <a href=\"%3$s\">install and activate WCPOS Pro</a>"
msgstr ""
"<strong>WCPOS</strong> ត្រូវការកំណែ <a href=\"%1$s\">WCPOS Pro %2$s ឬខ្ពស់ជាងនេះ</a>។ សូម<a href=\"%3$s\">ដំឡើង និងធ្វើឱ្យ WCPOS Pro សកម្ម</a>"

msgid "POS"
msgstr "POS"

msgid "View POS"
msgstr "មើល POS"

#. translators: wordpress.
msgid "Settings"
msgstr "ការកំណត់"

msgid "Templates"
msgstr "ពុម្ព"

msgid "Upgrade to Pro"
msgstr "ធ្វើឱ្យប្រសើរជាមួយ Pro"

msgid "Online"
msgstr "អនឡាញ"

msgid "POS Cashier"
msgstr "អ្នកគិតលុយ POS"

msgid "Search for a cashier&hellip;"
msgstr "ស្វែងរកអ្នកគិតលុយ&hellip;"

#. translators: 1: old POS cashier, 2: new POS cashier.
#, php-format
msgid "POS cashier changed from %1$s to %2$s."
msgstr "អ្នកគិតលុយ POS បានផ្លាស់ប្តូរពី %1$s ទៅ %2$s។"

#. translators: 1: old POS cashier, 2: new POS cashier.
msgid "Unknown"
msgstr "មិនស្គាល់"

msgid "POS base"
msgstr "មូលដ្ឋាន POS"

#. translators: wordpress.
msgid "Important:"
msgstr "សំខាន់:"

msgid "Major Update"
msgstr "បច្ចុប្បន្នភាពធំ"

msgid ""
"Update when you have time to test the POS. You can rollback to the previous version if needed."
msgstr ""
"ធ្វើបច្ចុប្បន្នភាពនៅពេលអ្នកមានពេលវេលាសាកល្បង POS។ អ្នកអាចត្រឡប់ទៅកំណែចាស់ប្រសិនបើចាំបាច់។"

msgid "Pro Users:"
msgstr "អ្នកប្រើប្រាស់ Pro:"

#. translators: %s: URL to My Account page
#, php-format
msgid ""
"WCPOS Pro is now a standalone plugin. Download the latest version from %s"
msgstr "WCPOS Pro ឥឡូវនេះគឺជាប្លុកឯករាជ្យ។ ទាញយកកំណែចុងក្រោយពី %s"

msgid "POS & Online"
msgstr "POS & អនឡាញ"

msgid "POS Only"
msgstr "មានតែ POS"

msgid "Online Only"
msgstr "មានតែអនឡាញ"

msgid "POS Barcode"
msgstr "បាកូដ POS"

msgid "Product barcode used at the point of sale"
msgstr "បាកូដផលិតផលដែលប្រើនៅចំណុចលក់"

msgid "Enable POS specific prices."
msgstr "បើកការប្រើប្រាស់តម្លៃជាក់លាក់សម្រាប់ POS។"

msgid "Enable POS specific taxes."
msgstr "បើកការប្រើប្រាស់ពន្ធជាក់លាក់សម្រាប់ POS។"

msgid "POS visibility"
msgstr "ភាពមើលឃើញ POS"

#. translators: wordpress.
msgid "Edit"
msgstr "កែប្រែ"

#. translators: wordpress.
msgid "OK"
msgstr "យល់ព្រម"

#. translators: wordpress.
msgid "Cancel"
msgstr "បោះបង់"

msgid "Error"
msgstr "កំហុស"

msgid "Settings failed to load, please contact support"
msgstr "ការកំណត់បានបរាជ័យក្នុងការផ្ទុក សូមទាក់ទងការគាំទ្រ"

msgid "Receipt Templates"
msgstr "ទម្រង់បញ្ជាប័ត្កា​អៀវ​រតាល​មាន"

msgid "Customise your POS receipts with PHP or logicless templates."
msgstr "ត្រូវចូលទៅអាម៉ាស់​ដោយប្រើ PHP ឬ​​ទម្រង់​គ្មាន​ច​និន​ិ​តា​ឡើន។"

#. translators: %s: URL to template documentation
#, php-format
msgid ""
"<a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Read the documentation</a> for a complete reference and examples."
msgstr ""
"អាន< a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">សេចក្តី​ណែនាំ​លម្អិត</a>​ សម្រាប់អ្វីយើងបានអានច្បាស់លាស់ និង​​ឧទាហរណា។"

msgid "Starter Templates"
msgstr "ទម្រង់ចាប់ផ្តើម​"

msgid ""
"Ready-made examples that demonstrate different receipt styles. Install one to get a working template you can customise."
msgstr ""
"ឧទាហរណ៍ដែលបំពេញ​តាមទេតាមប៉ុន្មានរបាយការណ៍បើក។ ដំឡើងមួយ ដើម្បីចាប់ផ្តើមទម្រង់ដែលអ្នកត្រូវតែផ្គូផ្គង។"

msgid "Offline"
msgstr "មិនទាក់ទងទូរគម​"

msgid "Install"
msgstr "ដំឡើង​"

msgid "Default Templates"
msgstr "ពុម្ពលំនាំលំនាំដើម"

msgid ""
"These templates are automatically detected from your plugin and theme files. They cannot be deleted."
msgstr ""
"ពុម្ពទាំងនេះត្រូវបានរកឃើញដោយស្វ័យប្រវត្តិពីប្លុក និងឯកសារធំរបស់អ្នក។ មិនអាចលុបបាន។"

msgid "Template"
msgstr "ពុម្ព"

msgid "Type"
msgstr "ប្រភេទ"

msgid "Source"
msgstr "ប្រភព"

msgid "Status"
msgstr "ស្ថានភាព"

msgid "Actions"
msgstr "សកម្មភាព"

msgid "Theme"
msgstr "ស្បែក"

msgid "Plugin"
msgstr "ប្លុក"

msgid "Active"
msgstr "សកម្ម"

msgid "Inactive"
msgstr "អសកម្ម"

msgid "Preview"
msgstr "មើលជាមុន"

msgid "Activate"
msgstr "បើកដំណើរការ"

msgid "Copy"
msgstr "ចម្លង"

msgid "Custom Templates"
msgstr "ពុម្ពផ្ទាល់ខ្លួន"

msgid ""
"Create your own custom templates or copy a default template to customize."
msgstr "បង្កើតពុម្ពផ្ទាល់ខ្លួនរបស់អ្នកឬចម្លងពុម្ពលំនាំដើមដើម្បីប្ដូរតាមបំណង។"

msgid "Template Preview"
msgstr "មើលជាមុនពុម្ព"

msgid "Close"
msgstr "បិទ"

msgid "Open in New Tab"
msgstr "បើកក្នុងផ្ទាំងថ្មី"

msgid "Invalid template ID."
msgstr "លេខសម្គាល់ពុម្ពមិនត្រឹមត្រូវ។"

msgid "Security check failed."
msgstr "ការត្រួតពិនិត្យសុវត្ថិភាពបរាជ័យ។"

msgid "You do not have permission to activate templates."
msgstr "អ្នកមិនមានសិទ្ធិបើកដំណើរការពុម្ពទេ។"

msgid "You do not have permission to copy templates."
msgstr "អ្នកមិនមានសិទ្ធិចម្លងពុម្ពទេ។"

msgid "Template not found."
msgstr "ពុម្ពមិនបានរកឃើញ។"

#. translators: %s: original template title
#, php-format
msgid "Copy of %s"
msgstr "ចម្លងនៃ %s"

msgid "Template activated successfully."
msgstr "ពុម្ពបានបើកដំណើរការដោយជោគជ័យ។"

msgid "Template copied successfully. You can now edit your custom template."
msgstr "ពុម្ពបានចម្លងដោយជោគជ័យ។ ឥឡូវអ្នកអាចកែសម្រួលពុម្ពផ្ទាល់ខ្លួនរបស់អ្នក។"

msgid ""
"Starter template installed. You can now customise it and activate it when ready."
msgstr ""
"បន្លិកានៃទម្រង់ចាប់ផ្តើម​ត្រូវ​បានដំឡើង។ ឥឡូវអ្នកត្រូវ​តែផ្គូផ្គងវាបាន និង កំណត់​ការប្រើ​វា​នៅពេលបានបំពេញ។"

msgid "Failed to activate template."
msgstr "បរាជ័យក្នុងការបើកដំណើរការពុម្ព។"

msgid "Invalid starter template key."
msgstr "មិន​ទាន់ត្រឹមត្រូវនឹង​​​គម្លើសទម្រង់ចាប់ផ្តើម។"

msgid "You do not have permission to install templates."
msgstr "ក្រុមងារទទួលធ្វើ​សិទ្ធិ​គ្មាន​​ទេក្នុងការដំដាលទម្រង់។"

msgid "Category"
msgstr "ប្រភេទ"

msgid "HTML (Offline)"
msgstr "HTML (មិន​ទាក់ទងទូរគម)"

msgid "XML (Receipt Printer)"
msgstr "XML (ម៉ាស៊ីនបោះពុម្ពបញ្ជាប័ត្កា)"

msgid "PHP (Legacy)"
msgstr "PHP (ប្រព័ន្ធចាស់)"

msgid "Enter template name"
msgstr "បញ្ចូលឈ្មោះពុម្ព"

msgid "Back to Templates"
msgstr "ត្រឡប់ទៅទម្រង់"

msgid "Publish"
msgstr "ប៊ើកប្រអប់"

msgid "Template Actions"
msgstr "សកម្មភាពពុម្ព"

msgid "Template Settings"
msgstr "ការកំណត់ពុម្ព"

msgid ""
"Prints using your browser's print dialog. Renders on the device without needing a server connection."
msgstr ""
"បោះពុម្មចាត់វិធីបញ្ជាំងនិច្ចរបស់លោកអ្នក។ បង្ហាញលើអ៊ីម៉ាស់ដោយគ្មានការតភ្ជាប់ផ្នែកសេវាកម្ម។"

msgid ""
"Sends output directly to thermal printers like Epson or Star. Works offline."
msgstr "ផ្ញើលទ្ធផលទៅអោបបែបទាត់ដូចជា Epson ឬ Star។ ដំណើរការភ្លាមៗ។"

msgid ""
"Prints using your browser's print dialog. Requires a server connection to generate the receipt."
msgstr ""
"បោះពុម្មចាត់វិធីប្រអប់បញ្ជាំង។ ត្រូវការការតភ្ជាប់វេទិកាលើកកើតរបាយការណ៍។"

msgid "Template Engine"
msgstr "ម៉ាស៊ីនដ្ឋានផ្ទាំងសរសៃ"

msgid "Paper Size"
msgstr "ទំហំក្រាស់ប៊កសំណង់"

msgid "80mm (Standard)"
msgstr "80ម។ម (ប្រព័ន្ធមូលដ្ឋាន)"

msgid "58mm (Narrow)"
msgstr "58ម។ម (ស្ងួតប្រស្ន៍)"

msgid "This template is currently active"
msgstr "ពុម្ពនេះកំពុងដំណើរការបច្ចុប្បន្ន"

msgid "Set as Active Template"
msgstr "កំណត់ជាពុម្ពដំណើរការ"

msgid "You do not have permission to create templates."
msgstr "អ្នកមិនមានសិទ្ធិបង្កើតពុម្ពទេ។"

msgid "Failed to create template copy."
msgstr "បរាជ័យក្នុងការបង្កើតចម្លងពុម្ព។"

msgid "Sample Customer"
msgstr "អតិថិជនសាកល្បង"

msgid "Sample Cashier"
msgstr "បុគ្គលិកគ្រប់គ្រងប្រាក់សាកល្បង"

msgid "You do not have permission to access the POS."
msgstr "អ្នកមិនមានសិទ្ធិចូលប្រើ POS ទេ។"

msgid "The refresh token to use for generating a new access token."
msgstr "សញ្ញាសម្គាល់ស្រស់សម្រាប់បង្កើតសញ្ញាសម្គាល់ចូលថ្មី។"

msgid "The user ID to get sessions for. Defaults to current user."
msgstr "លេខសម្គាល់អ្នកប្រើសម្រាប់ទទួលបានសម័យ។ លំនាំដើមទៅអ្នកប្រើបច្ចុប្បន្ន។"

msgid "The user ID to delete sessions for."
msgstr "លេខសម្គាល់អ្នកប្រើសម្រាប់លុបសម័យ។"

msgid "Whether to keep the current session."
msgstr "ថាតើត្រូវរក្សាសម័យបច្ចុប្បន្នឬអត់។"

msgid "The session JTI to delete."
msgstr "JTI សម័យដែលត្រូវលុប។"

msgid "The user ID that owns the session."
msgstr "លេខសម្គាល់អ្នកប្រើដែលជាម្ចាស់សម័យ។"

msgid "Missing required parameters."
