#: includes/Services/File_Integrity.php:225
msgid "WCPOS file integrity"
msgstr "សុចរិតភាពឯកសារ WCPOS"

#: includes/Services/File_Integrity.php:254
msgid "WCPOS"
msgstr "WCPOS"

#: includes/Services/File_Integrity.php:257
msgid "WCPOS files match the published checksums"
msgstr "ឯកសារ WCPOS ត្រូវគ្នានឹង checksum ដែលបានផ្សព្វផ្សាយ"

#: includes/Services/File_Integrity.php:258
msgid ""
"Every WCPOS plugin file matches the checksums published for this version."
