msgstr "주문 인쇄용 영수증 템플릿"

msgid "Report templates for analytics"
msgstr "분석용 보고서 템플릿"

msgid "Missing or invalid redirect_uri parameter."
msgstr "누락되었거나 잘못된 redirect_uri 매개변수입니다."

msgid "Missing state parameter."
msgstr "누락된 state 매개변수입니다."

msgid "Too many requests. Please try again later."
msgstr "요청이 너무 많습니다. 나중에 다시 시도하세요."

msgid "Auth session expired. Please try logging in again from the app."
msgstr "인증 세션이 만료되었습니다. 앱에서 다시 로그인해 주세요."

msgid "Invalid auth session. Please try logging in again from the app."
msgstr "잘못된 인증 세션입니다. 앱에서 다시 로그인해 주세요."

msgid "Security check failed. Please try again."
msgstr "보안 검사에 실패했습니다. 다시 시도하세요."

msgid "Authentication failed."
msgstr "인증 실패."

msgid ""
"This account is temporarily locked due to too many failed login attempts. "
"Please try again later."
msgstr "로그인 시도가 너무 많아 이 계정이 일시적으로 잠겼습니다. 나중에 다시 시도하세요."

msgid "You do not have permission to access the POS."
msgstr "POS에 접근할 권한이 없습니다."

msgid "Failed to generate authentication tokens."
msgstr "인증 토큰 생성 실패."

msgid "Please enter both username and password."
msgstr "사용자 이름과 비밀번호를 모두 입력하세요."

msgid "Invalid username or password."
msgstr "잘못된 사용자 이름 또는 비밀번호."

#. translators: wordpress.
msgid "You do not have sufficient permissions to access this page."
msgstr "이 페이지에 접근할 충분한 권한이 없습니다."

msgid "This order cannot be paid for. Please contact us if you need assistance."
msgstr "이 주문은 결제할 수 없습니다. 도움이 필요하시면 연락주세요."

msgid "Pay for order"
msgstr "주문 결제"

msgid "Checkout Settings"
msgstr "결제 설정"

msgid ""
"Scripts and styles may interfere with the custom payment template, use this "
"form to dequeue any problematic scripts."
msgstr "스크립트와 스타일이 맞춤 결제 템플릿에 영향을 줄 수 있습니다. 이 양식을 사용하여 문제 있는 스크립트를 제거하세요."

msgid "Disable All Styles and Scripts"
msgstr "모든 스타일 및 스크립트 비활성화"

msgid "Disable wp_head"
msgstr "wp_head 비활성화"

msgid "Disable wp_footer"
msgstr "wp_footer 비활성화"

msgid "Disable Selected Styles"
msgstr "선택한 스타일 비활성화"

msgid "Disable Selected Scripts"
msgstr "선택한 스크립트 비활성화"

msgid "Submit"
msgstr "제출"

msgid "Paying as customer"
msgstr "고객으로 결제 중"

msgid "Guest"
msgstr "손님"

msgid "Sorry, this order is invalid and cannot be paid for."
msgstr "죄송합니다, 이 주문은 유효하지 않아 결제할 수 없습니다."

msgid "Sorry, this order has already been paid for."
msgstr "죄송합니다, 이 주문은 이미 결제되었습니다."

msgid "Sorry, this order is invalid."
msgstr "죄송합니다, 이 주문은 유효하지 않습니다."

msgid "You do not have permission to view this receipt."
msgstr "이 영수증을 볼 권한이 없습니다."

msgid "Receipt Error"
msgstr "영수증 오류"

msgid "Receipt Template Error"
msgstr "영수증 템플릿 오류"

msgid ""
"There was a problem rendering the receipt template. This is usually caused "
"by a syntax error or undefined variable in the template code."
msgstr "영수증 템플릿을 렌더링하는 데 문제가 발생했습니다. 이는 일반적으로 템플릿 코드의 구문 오류 또는 정의되지 않은 변수로 인해 발생합니다."

msgid "File:"
msgstr "파일:"

msgid "Line:"
msgstr "줄:"

msgid "Suggestions:"
msgstr "제안:"

msgid ""
"Check the template file for syntax errors (missing semicolons, brackets, "
"etc.)"
msgstr "템플릿 파일에서 구문 오류(세미콜론, 괄호 등 누락)를 확인하세요."

msgid "Ensure all variables used in the template are defined"
msgstr "템플릿에서 사용된 모든 변수가 정의되어 있는지 확인하세요."

msgid "Verify that any custom functions or classes exist"
msgstr "맞춤 함수나 클래스가 존재하는지 확인하세요."

msgid "Try resetting to the default receipt template"
msgstr "기본 영수증 템플릿으로 재설정해 보세요."

msgid "Please contact the site administrator for assistance."
msgstr "도움을 받으려면 사이트 관리자에게 문의하세요."

msgid "Invalid template language."
msgstr "잘못된 템플릿 언어."

#. translators: %s: pattern that was found.
#, php-format
msgid "Template contains potentially dangerous JavaScript code: %s"
msgstr "템플릿에 잠재적으로 위험한 JavaScript 코드가 포함되어 있습니다: %s"

#. translators: %s: error message.
#, php-format
msgid "PHP syntax error: %s"
msgstr "PHP 구문 오류: %s"

msgid "PHP syntax error: Mismatched PHP tags."
msgstr "PHP 구문 오류: PHP 태그 불일치."

#. translators: %s: function name.
#, php-format
msgid ""
"Template contains dangerous function: %s(). This function is not allowed "
"for security reasons."
msgstr "템플릿에 위험한 함수가 포함되어 있습니다: %s(). 보안상의 이유로 이 함수는 허용되지 않습니다."

